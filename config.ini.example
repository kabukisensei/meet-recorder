[audio]
sys_volume = 1.0
mic_volume = 2.0
sample_rate = 16000
# Which source the "Me" track records:
#   raw   - the mic the call uses (default; follows the default mic).
#   auto  - raw as above, PLUS an echo-cancelled extra track of that mic (a
#           private PipeWire process started after the recorders, for the
#           recording only, never visible to Teams). The extra track is used
#           only if it is complete, kept your voice, and the call's mic and
#           speaker never changed; otherwise the raw mic is used. Skipped
#           when the call app plays to a non-default speaker. With speakers
#           this removes the far side from me.m4a. Opt-in until it has
#           passed a real call.
#   <node.name> - a specific PipeWire source (no echo cancellation).
mic_source = raw

[whisper]
model = small
device = cpu
compute_type = int8
beam_size = 5
# Vocabulary/context given to whisper for both tracks: names, product and
# team terms it would otherwise misspell. Keep it to one short line.
initial_prompt = Tanner, FocusTime, Omarchy, SER9, Hyprland, PipeWire
# Feed the previous text back as context (better continuity; set false if a
# transcript ever gets stuck repeating a phrase).
condition_on_previous_text = true

[paths]
output_dir = ~/Recordings

[auto]
enabled = true
apps = teams
poll_seconds = 2
start_after_seconds = 4
stop_after_seconds = 20

[speakers]
# Names used in transcript.vtt voice tags (FocusTime export).
# `others` is also used for unlabelled (single-track) segments.
me = Me
others = Others

[screens]
# Screen moments: while recording, keep a JPEG of the call window whenever its
# content changes and then holds still (slides, shared docs). Live video never
# holds still, so camera-only stretches produce no frames.
enabled = true
window_class = teams-for-linux
interval_seconds = 3
# The thumbnail is split into a 12x12 grid; values are fractions 0-1 of the
# mean absolute pixel difference within a cell. A cell that keeps moving
# (camera tiles, speaking rings) is "volatile" and ignored: volatile after
# moving in volatile_ticks of the last volatile_window ticks, calm again after
# volatile_window still ticks. A frame is kept when no calm cell moved by
# more than stable_threshold for settle_ticks ticks AND the calm cells that
# differ from the last kept frame by > cell_change_threshold include ONE
# connected region (cells up to one empty cell apart) of at least
# region_fraction of the whole window: a slide/doc/share, not speaking rings,
# name labels or gallery reflow. Nothing is kept while more than
# max_volatile of the window is volatile (full-screen video), or while the
# window is narrower than min_width logical px (a narrow tile).
# A tick on which >= burst_fraction of the cells start moving after 2 still
# ticks is a transition (slide change, fade): those moves, and the cells'
# next transition_ticks - 1 moves, are not counted as video.
stable_threshold = 0.02
cell_change_threshold = 0.02
region_fraction = 0.25
min_width = 900
volatile_ticks = 2
volatile_window = 5
max_volatile = 0.85
burst_fraction = 0.1
transition_ticks = 2
settle_ticks = 2
min_gap_seconds = 10
max_frames = 300
# Disk guards: stop keeping frames past max_mb, or when the disk would have
# less than min_free_mb left (the audio shares that disk). Copying frames
# into the recording folder also stops before that disk drops below
# min_free_mb (the transcript is written there too).
max_mb = 300
min_free_mb = 1024
jpeg_quality = 80

[summary]
# Command run (detached) after a successful transcription.
# {folder} is replaced with the session folder. Leave empty to disable.
summary_cmd =
