#!/usr/bin/env bash
# Summarize a meet-recorder transcript with agy (Google AI Pro quota).
# Usage: meet-recorder-summarize [path-to-meeting-dir]
#   (default: the newest recording with a transcript.md under [paths] output_dir)
set -euo pipefail
mr="$(dirname "$0")/meet-recorder"
[ -x "$mr" ] || mr=meet-recorder
dir="${1:-}"
if [ -z "$dir" ]; then
  dir=$("$mr" latest 2>/dev/null) || dir=""
fi
[ -n "$dir" ] || { echo "no recording found" >&2; exit 1; }
t="$dir/transcript.md"
[ -f "$t" ] || { echo "no transcript.md in $dir" >&2; exit 1; }

prompt=$(cat <<PROMPT
Here is a meeting transcript with timestamps. Produce:
1. A 3-5 sentence summary of what was discussed.
2. Action items as a markdown checkbox list (owner in parentheses if mentioned).
3. Key decisions made, as bullets.
End every action item and every decision with the timestamp of the transcript
line it came from, written as [mm:ss] (the start of that line's [mm:ss -> mm:ss]),
e.g. "- [ ] Move the ticket to DevOps (Tanner) [12:34]".
If the transcript is too sparse to summarize, say exactly: TRANSCRIPT_TOO_SPARSE

--- TRANSCRIPT ---
$(cat "$t")
PROMPT
)

out=$(env -u SSH_CONNECTION -u SSH_CLIENT -u SSH_TTY \
  DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:path=/run/user/1000/bus}" \
  agy -p "$prompt")

if [ "$out" = "TRANSCRIPT_TOO_SPARSE" ]; then
  echo "transcript too sparse to summarize: $dir" >&2
  exit 3
fi
printf "%s\n" "$out" | tee "$dir/summary.md"
echo "written: $dir/summary.md"

# Link each [mm:ss]-tagged line to the screen frame showing at that moment
# (local post-processing only; images are never sent to agy).
if [ -f "$dir/screens.json" ]; then
  "$mr" link-screens "$dir" >/dev/null || echo "link-screens failed (summary kept)" >&2
fi
