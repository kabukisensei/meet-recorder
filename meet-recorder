def cmd_toggle(args=()):
    if session_live(read_state()):
        return cmd_stop()
    return cmd_start()


def auto_enabled(cfg):
    return cfg.getboolean("auto", "enabled", fallback=True)


def cmd_auto(args=()):
    """auto on|off|toggle|status — whether Teams calls are recorded automatically."""
    cfg = ensure_config()
    want = args[0] if args else "status"
    if want in ("on", "off", "toggle"):
        new = (not auto_enabled(cfg)) if want == "toggle" else want == "on"
        cfg.set("auto", "enabled", "true" if new else "false")
        with open(CONFIG_FILE, "w") as f:
            cfg.write(f)
    print("on" if auto_enabled(cfg) else "off")
    return 0


def status_dict():
    cfg = load_config()
    state = read_state()
    live = session_live(state)
    jobs = active_jobs()
    watch = read_json(WATCH_FILE) or {}
    watching = (pid_alive(watch.get("pid", -1))
                and time.time() - watch.get("beat", 0) < 30)
    last = read_json(LAST_FILE) or {}
    return {
        "state": "recording" if live else ("transcribing" if jobs else "idle"),
        "elapsed": int(time.time() - state["start"]) if live else 0,
        "source": state.get("source", "manual") if live else "",
        "title": state.get("title", "") if live else "",
        "transcribing": len(jobs),
        "auto": auto_enabled(cfg),
        "watching": watching,
        "in_call": bool(watch.get("in_call")) if watching else False,
        "last_folder": last.get("folder", ""),
        "last_status": last.get("status", ""),
        "output_dir": os.path.expanduser(cfg.get("paths", "output_dir")),
    }


def cmd_status(args=()):
    st = status_dict()
    if "--json" in args:
        print(json.dumps(st))
    elif st["state"] == "recording":
        print(f"recording {st['elapsed']}")
    else:
        print(st["state"])
    return 0


def cmd_watch(args=()):
    """Daemon: record automatically while a watched app (Teams) is in a call.

    Only stops recordings it started itself. If you stop an auto-recording by
    hand mid-call, it stays stopped until the next call.
    """
    cfg = ensure_config()
    state = read_state()
    if state is not None and not session_live(state):
        recover_stale(state)

    seen_since = None      # when the call was first seen
    gone_since = None      # when the call was last seen ending
    handled = False        # this call was already recorded (or declined)
    cfg_mtime = 0
    while True:
        try:
            mtime = os.path.getmtime(CONFIG_FILE)
        except OSError:
            mtime = 0
        if mtime != cfg_mtime:
            cfg, cfg_mtime = load_config(), mtime
        now = time.time()
        in_call = call_active(cfg)
        state = read_state()
        live = session_live(state)

        if in_call:
            gone_since = None
            seen_since = seen_since or now
            if live:
                handled = True   # something is already recording this call
            elif (not handled and auto_enabled(cfg) and now - seen_since
                    >= cfg.getfloat("auto", "start_after_seconds")):
                handled = True
                cmd_start(source="teams")
        else:
            seen_since = None
            if handled or live:
                gone_since = gone_since or now
                if now - gone_since >= cfg.getfloat("auto", "stop_after_seconds"):
                    if live and state.get("source") == "teams":
                        cmd_stop()
                    handled, gone_since = False, None
            else:
                handled, gone_since = False, None

        write_json(WATCH_FILE, {"pid": os.getpid(), "beat": int(now),
                                "in_call": in_call})
        time.sleep(max(0.5, cfg.getfloat("auto", "poll_seconds")))


COMMANDS = {"start": cmd_start, "stop": cmd_stop, "toggle": cmd_toggle,
            "status": cmd_status, "auto": cmd_auto, "watch": cmd_watch,
            "transcribe": cmd_transcribe, "export": cmd_export,
            "moments": cmd_moments, "link-screens": cmd_link_screens,
            "screens-loop": cmd_screens_loop}


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if not argv or argv[0] not in COMMANDS:
        print("usage: meet-recorder start|stop|toggle|status [--json]|"
              "auto on|off|toggle|watch|transcribe <folder>|"
              "export <folder>...|moments <folder>...|"
              "link-screens <folder>...", file=sys.stderr)
        return 2
    return COMMANDS[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main())
