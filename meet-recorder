# Thumbnail width (logical px) used to compare frames; small keeps the loop
# cheap (~250x140 px on a 1.25x display) while a line of slide text still
# changes a cell by far more than stable_threshold.
SCREEN_THUMB_WIDTH = 200
# Grid for the volatile mask. 12 x 12 = 144 cells: on that thumbnail a cell
# is ~20x12 px (<1 % of the window), so a camera strip (>= ~10 % of the
# height) covers whole rows of cells and masks little shared content around
# it, while one cell still averages enough pixels that a changed text line
# stands out clearly from a caret or a speaking ring (which only light up
# a cell or two and become volatile anyway).
SCREEN_GRID = 12


