def newest_transcript_folder(base):
    """Newest <base>/YYYY-MM-DD/<HHMMSS-...>/ that contains transcript.md
    (any source: manual, teams, legacy meeting), or None."""
    best = None
    try:
        days = [d for d in os.listdir(base)
                if re.fullmatch(r"\d{4}-\d{2}-\d{2}", d)]
    except OSError:
        return None
    for day in days:
        try:
            names = os.listdir(os.path.join(base, day))
        except OSError:
            continue
        for name in names:
            folder = os.path.join(base, day, name)
            if (re.match(r"\d{6}-", name)
                    and os.path.isfile(os.path.join(folder, "transcript.md"))
                    and (best is None or (day, name) > best[0])):
                best = ((day, name), folder)
    return best[1] if best else None


