def folder_segments(folder):
    """(segment dicts, from_md) for a session folder.

    segments.json is trusted only when it is valid, non-empty and not older
    than transcript.md (a failed refresh after a re-transcription must not
    resurrect the previous transcript); otherwise transcript.md is parsed.
    Without transcript.md, segments.json errors are raised as they are.
    Raises OSError / ValueError.
    """
    seg_path = os.path.join(folder, "segments.json")
    md_path = os.path.join(folder, "transcript.md")
    try:
        md_mtime = os.stat(md_path).st_mtime_ns
    except FileNotFoundError:
        md_mtime = None
    if os.path.exists(seg_path):
        try:
            if md_mtime is not None and os.stat(seg_path).st_mtime_ns < md_mtime:
                raise ValueError("segments.json is older than transcript.md")
            with open(seg_path, encoding="utf-8") as f:
                segs = validate_segments(json.load(f))
            if segs or md_mtime is None:
                return segs, False
        except (OSError, ValueError):
            if md_mtime is None:
                raise
    if md_mtime is None:
        raise FileNotFoundError("no segments.json or transcript.md to export")
    meta = read_json(os.path.join(folder, "meta.json"))
    labels = bool(meta.get("speaker_labels")) if isinstance(meta, dict) else None
    with open(md_path, encoding="utf-8") as f:
        return parse_md_transcript(f.read(), labels), True


def die_with_parent():
    """preexec_fn: the child gets SIGKILL when this process dies (Linux
    PR_SET_PDEATHSIG), or exits at once if it already has."""
    parent = os.getpid()
    try:
        prctl = ctypes.CDLL(None, use_errno=True).prctl
    except (OSError, AttributeError):
        return None

    def preexec():
        prctl(1, signal.SIGKILL)            # PR_SET_PDEATHSIG
        if os.getppid() != parent:
            os._exit(1)
    return preexec


class CaptureRunner:
    """Runs one capture subprocess (hyprctl / grim) at a time with a hard
    timeout (<= 10 s). kill() -- called from the stop signal handler --
    ends the running one at once (also one spawned while the signal was
    being handled). Each child gets PR_SET_PDEATHSIG = SIGKILL, so it dies
    with the worker even if the worker itself is SIGKILLed or crashes."""

    def __init__(self, env):
        self.env, self.proc, self.stopping = env, None, False

    def run(self, argv, timeout):
        if self.stopping:
            raise RuntimeError("stopping")
        p = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                             env=self.env, preexec_fn=die_with_parent())
        self.proc = p
        if self.stopping:        # the stop signal arrived during the spawn
            p.kill()
        try:
            out, err = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            p.kill()
            p.communicate()
            raise RuntimeError(f"{argv[0]} timed out after {timeout:g} s")
        finally:
            self.proc = None
            if p.poll() is None:
                p.kill()
                p.wait()
        if p.returncode != 0:
            raise RuntimeError(f"{argv[0]} failed ({p.returncode}): "
                               + err.decode(errors="replace").strip()[:300])
        return out

    def kill(self):
        self.stopping = True
        p = self.proc
        if p is not None:
            try:
                p.kill()
            except OSError:
                pass


def grab_thumb(runner, stable_id, width):
    """Tiny PPM thumbnail of one window via grim -T (works off-screen)."""
    scale = min(1.0, SCREEN_THUMB_WIDTH / max(1, width))
    return parse_ppm(runner.run(["grim", "-T", stable_id, "-s", f"{scale:.4f}",
                                 "-t", "ppm", "-"], timeout=5))


def grab_frame(runner, stable_id, quality):
    """Full-resolution JPEG bytes of one window (grim writes to a pipe, so
    no file exists until we create it ourselves, 0600)."""
    data = runner.run(["grim", "-T", stable_id, "-t", "jpeg",
                       "-q", str(quality), "-"], timeout=10)
    if not data.startswith(b"\xff\xd8"):
        raise RuntimeError("grim returned no JPEG")
    return data


def frame_budget_error(used, free, size, p):
    """Why a frame of `size` bytes must not be written (None if it may):
    the screenshot byte budget, or the free space the audio needs."""
    if used + size > p["max_mb"] * 1e6:
        return f"screenshot budget reached (max_mb = {p['max_mb']:g})"
    if free - size < p["min_free_mb"] * 1e6:
        return (f"disk nearly full: keeping min_free_mb = "
                f"{p['min_free_mb']:g} for the audio")
    return None


def screens_session_ok(raw, session_id):
    """The capture worker's lifetime check: its raw dir exists, session.json
    still names this session (id, or raw dir for an id-less session) and
    at least one audio recorder is still the process we started."""
    if not os.path.isdir(raw):
        return False
    state = read_state()
    if not state:
        return False
    if session_id:
        if state.get("id") != session_id:
            return False
    elif state.get("session_dir") != raw:
        return False
    return session_live(state)


SCREENS_LOG_MAX = 256 * 1024


def cmd_screens_loop(args=()):
    """Hidden: capture "new and settled" frames of the call window into
    <raw>/screens/ until the session ends (spawned by start, stopped by
    stop). args: <raw-dir> [<session-id> <monotonic-origin>]."""
    if not args:
        print("usage: meet-recorder screens-loop <session-raw-dir> "
              "[<session-id> <origin>]", file=sys.stderr)
        return 2
    raw = os.path.abspath(args[0])
    session_id = args[1] if len(args) > 1 else ""
    try:
        origin = float(args[2])
    except (IndexError, ValueError):
        origin = time.monotonic()
    shots = os.path.join(raw, "screens")
    log_path = os.path.join(raw, "screens.log")
    manifest = os.path.join(raw, "screens.jsonl")
    if not os.path.isdir(raw):          # session already over: never recreate
        return 0
    make_private_dir(raw)
    make_private_dir(shots)
    p = screen_params(load_config())
    runner = CaptureRunner(hypr_env())
    try:
        os.nice(10)
    except OSError:
        pass

    stop = []

    def on_signal(*_):
        stop.append(1)
        runner.kill()
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, on_signal)

    last_err = [None]

    def log(msg):
        """Best effort, bounded: identical repeats are logged once, the log
        stops growing at SCREENS_LOG_MAX, and a full disk is ignored."""
        if msg == last_err[0]:
            return
        last_err[0] = msg
        try:
            if os.path.getsize(log_path) > SCREENS_LOG_MAX:
                return
        except OSError:
            pass
        try:
            append_private(log_path, time.strftime("%H:%M:%S ") + msg + "\n")
        except OSError:
            pass

    misses, last_check = [0], [0.0]

    def session_over():
        """Checked about every second, independent of the capture cadence;
        three misses in a row (a fresh worker may run before start has
        published session.json) end the loop."""
        last_check[0] = time.monotonic()
        try:
            ok = screens_session_ok(raw, session_id)
        except Exception:
            ok = False
        misses[0] = 0 if ok else misses[0] + 1
        return not os.path.isdir(raw) or misses[0] >= 3

    keep_state, prev, kept_thumb = dict(SCREEN_KEEP_START), None, None
    prev_sid, used, last_size = None, 0, 1_000_000
    next_tick = time.monotonic()
    while not stop and not session_over():
        try:
            out = runner.run(["hyprctl", "clients", "-j"], timeout=5)
            try:
                clients = json.loads(out)
            except ValueError:
                raise RuntimeError("hyprctl clients: bad JSON")
            win = pick_screen_window(clients, p["window_class"])
            if win is None:
                prev = None
                log(f"no window of class {p['window_class']!r}")
            else:
                sid = str(win["stableId"])
                if sid != prev_sid:            # another window: no stale diff
                    prev, prev_sid = None, sid
                try:
                    thumb = grab_thumb(runner, sid, (win.get("size") or [0])[0])
                except Exception:
                    prev = None                # failed sample: restart settling
                    raise
                t = time.monotonic() - origin
                d_prev = cell_diffs(prev, thumb)
                d_kept = cell_diffs(kept_thumb, thumb)
                prev = thumb
                new_state, keep = screen_keep_step(keep_state, d_prev, d_kept,
                                                   t, p)
                # A keep only counts once the JPEG and its manifest line are
                # both on disk; until then it is retried on later ticks.
                keep_state = dict(new_state, kept=keep_state["kept"],
                                  last_keep=keep_state["last_keep"])
                if keep:
                    st = os.statvfs(raw)
                    free = st.f_bavail * st.f_frsize
                    why = frame_budget_error(used, free, last_size, p)
                    if why:
                        raise RuntimeError(why)
                    data = grab_frame(runner, sid, p["jpeg_quality"])
                    why = frame_budget_error(used, free, len(data), p)
                    if why:
                        raise RuntimeError(why)
                    name = screen_file_name(t)
                    path = os.path.join(shots, name)
                    w, h = jpeg_size(data[:65536])
                    write_bytes_atomic(path, data, private=True)
                    try:
                        append_private(manifest, json.dumps({
                            "t": round(t, 1), "file": name,
                            "window_title": clean_window_title(
                                win.get("title", "")),
                            "w": w, "h": h}) + "\n")
                    except BaseException:
                        try:
                            os.remove(path)
                        except OSError:
                            pass
                        raise
                    keep_state, kept_thumb = new_state, thumb
                    used, last_size = used + len(data), len(data)
                last_err[0] = None
        except Exception as e:      # never let a bad tick end the loop
            if stop:
                break
            prev = None     # any failed tick (hyprctl too): no diff across it
            log(f"{type(e).__name__}: {e}")
        next_tick += p["interval_seconds"]
        now = time.monotonic()
        if next_tick < now:          # fell behind (suspend etc.): resync
            next_tick = now + p["interval_seconds"]
        while not stop and time.monotonic() < next_tick:
            time.sleep(min(0.25, max(0.0, next_tick - time.monotonic())))
            if (not stop and time.monotonic() - last_check[0] >= 1.0
                    and session_over()):
                return 0
    return 0


