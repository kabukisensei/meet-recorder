def run_json(argv, default):
    try:
        out = subprocess.run(argv, capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout) if out.returncode == 0 else default
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return default


def auto_apps(cfg):
    return [a.strip().lower() for a in cfg.get("auto", "apps").split(",")
            if a.strip()]


def call_active(cfg):
    """True when a watched app (Teams) currently holds the microphone open."""
    outs = run_json(["pactl", "-f", "json", "list", "source-outputs"], [])
    return bool(call_streams(outs, auto_apps(cfg)))


def meeting_title(cfg):
    apps = auto_apps(cfg)
    clients = run_json(["hyprctl", "clients", "-j"], [])
    titles = [c.get("title", "") for c in clients
              if any(a in str(c.get("class", "")).lower() for a in apps)]
    return pick_meeting_title(titles)


def hypr_env(env=None):
    """Environment for hyprctl/grim. Inherited when we run inside the
    graphical session; otherwise derive the Hyprland instance signature and
    Wayland socket from $XDG_RUNTIME_DIR (newest instance wins)."""
    env = dict(os.environ if env is None else env)
    runtime = env.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    env["XDG_RUNTIME_DIR"] = runtime
    if not env.get("HYPRLAND_INSTANCE_SIGNATURE"):
        base = os.path.join(runtime, "hypr")
        try:
            sigs = [d for d in os.listdir(base) if os.path.exists(
                os.path.join(base, d, ".socket.sock"))]
        except OSError:
            sigs = []
        if sigs:
            env["HYPRLAND_INSTANCE_SIGNATURE"] = max(
                sigs, key=lambda d: os.path.getmtime(os.path.join(base, d)))
    if not env.get("WAYLAND_DISPLAY"):
        try:
            socks = sorted(n for n in os.listdir(runtime)
                           if re.fullmatch(r"wayland-\d+", n))
        except OSError:
            socks = []
        env["WAYLAND_DISPLAY"] = socks[0] if socks else "wayland-1"
    return env


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def open_new_file(folder, name_prefix, mode):
    """Create a unique, empty temp file in folder with os.open semantics
    (mode is filtered by the umask). Returns (fd, path)."""
    while True:
        tmp = os.path.join(folder, f"{name_prefix}.{os.urandom(6).hex()}.tmp")
        try:
            return os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                           | os.O_CLOEXEC, mode), tmp
        except FileExistsError:
            continue


def write_bytes_atomic(path, data, private=False):
    """Publish bytes at path via a unique temp file + os.replace, so a
    failure never leaves a truncated file or clobbers the previous version
    (the temp file is removed on any error).

    Permissions: private -> 0600 (stricter if the umask says so);
    replacing an existing file -> keeps that file's mode; a new file ->
    0666 filtered by the umask, exactly like open(path, "w").
    """
    folder = os.path.dirname(path) or "."
    os.makedirs(folder, exist_ok=True)
    keep_mode = None
    if not private:
        try:
            keep_mode = stat.S_IMODE(os.stat(path).st_mode)
        except OSError:
            pass
    fd, tmp = open_new_file(folder, "." + os.path.basename(path),
                            0o600 if private else 0o666)
    try:
        with os.fdopen(fd, "wb") as f:
            if keep_mode is not None:
                os.fchmod(f.fileno(), keep_mode)
            f.write(data)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_text_atomic(path, text, private=False):
    """write_bytes_atomic for UTF-8 text."""
    write_bytes_atomic(path, text.encode("utf-8"), private)


def write_json(path, data, private=False):
    write_text_atomic(path, json.dumps(data, indent=1), private)


def active_jobs():
    """Folders currently being transcribed (drops markers of dead jobs)."""
    jobs = []
    try:
        names = os.listdir(JOBS_DIR)
    except FileNotFoundError:
        return jobs
    for name in names:
        path = os.path.join(JOBS_DIR, name)
        job = read_json(path)
        if job and pid_alive(job.get("pid", -1)):
            jobs.append(job)
        else:
            try:
                os.remove(path)
            except OSError:
                pass
    return jobs


