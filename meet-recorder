def fmt_ts(seconds):
    """Format a number of seconds as 'mm:ss' (minutes may exceed 59)."""
    total = int(seconds)
    m, s = divmod(total, 60)
    return f"{m:02d}:{s:02d}"


def format_segment(start, end, text, speaker=""):
    """Format one utterance as '[mm:ss -> mm:ss] [Speaker: ]text'."""
    who = f"{speaker}: " if speaker else ""
    return f"[{fmt_ts(start)} -> {fmt_ts(end)}] {who}{text.strip()}"


def vtt_ms(seconds):
    """Seconds -> whole milliseconds as used in a VTT timestamp (never < 0)."""
    return int(round(max(0.0, float(seconds)) * 1000))


def fmt_vtt_ms(ms):
    """Format whole milliseconds as WebVTT 'HH:MM:SS.mmm' (hours always present)."""
    h, ms = divmod(max(0, int(ms)), 3_600_000)
    m, ms = divmod(ms, 60_000)
    s, ms = divmod(ms, 1000)
    return f"{h:02d}:{m:02d}:{s:02d}.{ms:03d}"


def fmt_vtt_ts(seconds):
    """Format seconds as WebVTT 'HH:MM:SS.mmm' (hours always present, >= 0)."""
    return fmt_vtt_ms(vtt_ms(seconds))


def vtt_escape(text):
    """Escape text for a VTT cue; collapses whitespace (no blank lines/newlines).

    Escaping '>' also guarantees '-->' can never appear in the output.
    """
    text = " ".join(str(text).split())
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def segment_dicts(segments):
    """(start, end, text[, speaker]) tuples -> segments.json-style dicts."""
    out = []
    for seg in segments:
        start, end, text = seg[0], seg[1], seg[2]
        speaker = seg[3] if len(seg) > 3 else ""
        out.append({"start": float(start), "end": float(end),
                    "speaker": speaker or "", "text": str(text).strip()})
    return out


# Segment times beyond this (~115 days) are corrupt data, not a meeting; the
# bound also keeps the ms arithmetic far away from float overflow.
MAX_SEGMENT_SECONDS = 1e7


def validate_segments(segments):
    """Check a segments.json-style list; return normalized copies.

    Each item must be an object with finite numeric 'start' / 'end' within
    +-MAX_SEGMENT_SECONDS and a string 'text'; 'speaker' is optional
    (string). Raises ValueError naming the first bad item (absurd numbers
    such as 1e308 or a 400-digit integer included, never OverflowError).
    """
    if not isinstance(segments, list):
        raise ValueError("segments must be a list")
    out = []
    for i, d in enumerate(segments):
        if not isinstance(d, dict):
            raise ValueError(f"segment {i} is not an object")
        times = []
        for key in ("start", "end"):
            v = d.get(key)
            if isinstance(v, bool) or not isinstance(v, (int, float)):
                raise ValueError(f"segment {i}: '{key}' is not a finite number")
            try:
                v = float(v)
            except OverflowError:
                v = math.inf
            if not math.isfinite(v) or abs(v) > MAX_SEGMENT_SECONDS:
                raise ValueError(f"segment {i}: '{key}' is not a finite number "
                                 f"of seconds within {MAX_SEGMENT_SECONDS:g}")
            times.append(v)
        text, speaker = d.get("text"), d.get("speaker", "")
        if not isinstance(text, str):
            raise ValueError(f"segment {i}: 'text' is not a string")
        if speaker is None:
            speaker = ""
        if not isinstance(speaker, str):
            raise ValueError(f"segment {i}: 'speaker' is not a string")
        out.append({"start": times[0], "end": times[1],
                    "speaker": speaker, "text": text})
    return out


def speaker_name(label, me="Me", others="Others"):
    """Map a segment label ('Me' / 'Others' / '') to a display name."""
    if label == "Me":
        return me
    if label == "Others" or not label:
        return others
    return label


def segments_to_vtt(segments, me="Me", others="Others"):
    """Build a Teams-style WebVTT transcript from segment dicts.

    Cues are sorted by start time, numbered from 1, and empty texts skipped.
    Both endpoints are quantized to milliseconds first; then end is forced
    to be strictly after start (WebVTT requires end > start), which covers
    reversed, zero-length and same-millisecond segments. A blank voice name
    falls back to 'Me' / 'Others' (WebVTT needs a non-empty annotation).
    Cues are ordered by the original (unrounded) start, then end, so two
    starts that round to the same millisecond keep their spoken order.
    Names are escaped exactly once.
    """
    me = " ".join(str(me).split()) or "Me"
    others = " ".join(str(others).split()) or "Others"
    cues = []
    timed = []
    for d in validate_segments(segments):
        start_ms = vtt_ms(d["start"])
        end_ms = max(vtt_ms(d["end"]), start_ms + 1)
        timed.append((d["start"], d["end"], start_ms, end_ms, d))
    for _, _, start_ms, end_ms, d in sorted(timed, key=lambda t: (t[0], t[1])):
        text = vtt_escape(d["text"])
        if not text:
            continue
        label = d["speaker"]
        fallback = me if label == "Me" else others
        name = vtt_escape(speaker_name(label, me, others) or fallback)
        name = name or vtt_escape(fallback)
        cues.append(f"{len(cues) + 1}\n{fmt_vtt_ms(start_ms)} --> "
                    f"{fmt_vtt_ms(end_ms)}\n<v {name}>{text}</v>\n")
    return "WEBVTT\n\n" + "\n".join(cues)


_MD_LINE = re.compile(r"^\[(\d+):([0-5]\d) -> (\d+):([0-5]\d)\] ?(.*)$")
_MD_SPEAKER = re.compile(r"^(Me|Others): (.*)$", re.S)
MD_NO_SPEECH = "_No speech detected._"


def parse_md_line(line, labels=None):
    """Parse a transcript.md/.txt line '[mm:ss -> mm:ss] [Speaker: ]text'.

    Returns a segment dict, or None for headers / blank / other lines.
    labels: True / None -> a leading 'Me: ' / 'Others: ' (the only labels the
    recorder writes) is taken as the speaker; False -> the folder has no
    speaker labels (meta.json lacks speaker_labels), so the text is kept whole.
    The label is detected before stripping so 'Me: ' (empty utterance) stays
    an empty Me segment rather than the spoken text 'Me:'.
    """
    m = _MD_LINE.match(line.rstrip("\r\n"))
    if not m:
        return None
    start = int(m.group(1)) * 60 + int(m.group(2))
    end = int(m.group(3)) * 60 + int(m.group(4))
    text, speaker = m.group(5), ""
    sm = _MD_SPEAKER.match(text) if labels is not False else None
    if sm:
        speaker, text = sm.group(1), sm.group(2)
    return {"start": float(start), "end": float(end),
            "speaker": speaker, "text": text.strip()}


def parse_md_transcript(content, labels=None):
    """Parse a whole transcript.md/.txt into segment dicts.

    Lines that follow a timestamped record (until the next one) are
    continuation lines of that utterance (whisper text can contain newlines)
    and are kept, newline-joined; header lines before the first record are
    skipped. A line that looks like a record but has an impossible time
    (seconds > 59) is invalid input, never continuation text: ValueError.
    The recorder's own no-speech body (is_no_speech_md) yields []; any
    other input without a single record raises ValueError.
    """
    segs, lines = [], content.splitlines()
    for n, line in enumerate(lines, 1):
        d = parse_md_line(line, labels)
        if d is not None:
            segs.append(d)
        elif _MD_LINE_LOOSE.match(line):
            raise ValueError(f"line {n}: invalid timestamp in {line.strip()!r}")
        elif segs:
            segs[-1]["text"] += "\n" + line
    for d in segs:
        d["text"] = d["text"].strip()
    if not segs and not is_no_speech_md(content):
        raise ValueError("no '[mm:ss -> mm:ss] text' rows found in transcript")
    return segs


_MD_LINE_LOOSE = re.compile(r"^\[\d+:\d+ -> \d+:\d+\]")
_MD_HEADER = re.compile(r"^(# .*|Duration: \d+:\d\d)$")


def is_no_speech_md(content):
    """True only for the recorder's own no-speech transcript.md: at most the
    '# title' and 'Duration:' header lines, then the marker, nothing else."""
    rows = [l.strip() for l in content.splitlines() if l.strip()]
    if not rows or rows[-1] != MD_NO_SPEECH or len(rows) > 3:
        return False
    head = rows[:-1]
    return (all(_MD_HEADER.match(l) for l in head)
            and len({l[0] for l in head}) == len(head))


def _words(text):
    return re.findall(r"[a-z0-9']+", text.lower())


def merge_speakers(me, others, pad=3.0, echo_ratio=0.6):
    """Merge two per-track transcripts into one labelled, time-ordered list.

    me / others: lists of (start, end, text). Returns (start, end, text,
    speaker) tuples. When the call plays through speakers the mic hears the far
    side too, so a "Me" segment whose words mostly appear in what the others
    said at the same moment is treated as echo and dropped.
    """
    out = [(s, e, t, "Others") for s, e, t in others]
    for s, e, t in me:
        words = _words(t)
        if not words:
            continue
        nearby = set()
        for os_, oe, ot in others:
            if os_ <= e + pad and oe >= s - pad:
                nearby.update(_words(ot))
        hits = sum(1 for w in words if w in nearby)
        if nearby and hits / len(words) >= echo_ratio:
            continue
        out.append((s, e, t, "Me"))
    return sorted(out, key=lambda seg: (seg[0], seg[1]))


def session_dir_name(start_unix, slug="meeting"):
    """Return 'HHMMSS-<slug>' for a session starting at start_unix (local time)."""
    return time.strftime("%H%M%S", time.localtime(start_unix)) + "-" + slug


def slugify(text, max_len=40):
    """Lowercase, dash-separated, filesystem-safe slug ('' if nothing usable)."""
    slug = re.sub(r"[^a-z0-9]+", "-", str(text).lower()).strip("-")
    return slug[:max_len].strip("-")


def call_streams(source_outputs, apps):
    """Return the mic-capture streams that belong to one of `apps`.

    source_outputs: parsed `pactl -f json list source-outputs`.
    apps: lowercase substrings matched against the stream's application name
    and process binary. A matching app holding the mic open == a live call.
    """
    hits = []
    for so in source_outputs or []:
        props = so.get("properties", {}) or {}
        hay = " ".join(str(props.get(k, "")) for k in (
            "application.name", "application.process.binary",
            "application.id", "node.name")).lower()
        if "pw-record" in hay:
            continue  # our own recorder
        if any(a and a in hay for a in apps):
            hits.append(so)
    return hits


def app_device(streams, devices, apps, key, default):
    """Device a watched app's stream is attached to, if it is not the default.

    streams: `pactl -f json list sink-inputs` (key="sink") or source-outputs
    (key="source"); devices: the matching `list sinks` / `list sources`.
    Returns the device name to pin the recorder to, or "" to simply follow
    the system default (which also follows a mid-call headphone switch).
    """
    names = {d.get("index"): d.get("name", "") for d in devices or []}
    for st in call_streams(streams, apps):
        name = names.get(st.get(key), "")
        if name and not name.endswith(".monitor") and name != default:
            return name
    return ""


def pick_meeting_title(titles):
    """Pick the most meeting-like window title and strip the app suffix."""
    cleaned = []
    for t in titles:
        t = re.sub(r"\s*\|\s*Microsoft Teams\s*$", "", t or "").strip()
        if t:
            cleaned.append(t)
    if not cleaned:
        return ""
    for t in cleaned:
        if re.search(r"meeting|call|standup|sync", t, re.I):
            return t
    for t in cleaned:
        if not re.match(r"(chat|calendar|activity|teams|calls)\b", t, re.I):
            return t
    return ""


def clean_window_title(title):
    """Window title without the ' | Microsoft Teams' suffix."""
    return re.sub(r"\s*\|\s*Microsoft Teams\s*$", "", title or "").strip()


def pick_screen_window(clients, window_class):
    """The window to capture: a mapped client whose class contains
    window_class (case-insensitive); with several, the most meeting-like
    title (pick_meeting_title), else the largest. None if there is none."""
    want = (window_class or "").strip().lower()
    if not want:
        return None
    cands = [c for c in clients or []
             if want in str(c.get("class", "")).lower()
             and c.get("mapped", True) and c.get("stableId")]
    if not cands:
        return None
    best = pick_meeting_title([c.get("title", "") for c in cands])
    if best:
        for c in cands:
            if clean_window_title(c.get("title", "")) == best:
                return c

    def area(c):
        size = c.get("size") or [0, 0]
        return size[0] * size[1]
    return max(cands, key=area)


def parse_ppm(data):
    """Parse a binary PPM (P6) -> (width, height, maxval, pixel bytes).

    Raises ValueError on anything else (or truncated pixel data).
    """
    pos, tokens = 0, []
    if data[:2] != b"P6":
        raise ValueError("not a P6 PPM")
    pos = 2
    while len(tokens) < 3:
        while pos < len(data) and data[pos:pos + 1].isspace():
            pos += 1
        if data[pos:pos + 1] == b"#":           # comment to end of line
            while pos < len(data) and data[pos:pos + 1] not in (b"\n", b"\r"):
                pos += 1
            continue
        start = pos
        while pos < len(data) and data[pos:pos + 1].isdigit():
            pos += 1
        if start == pos:
            raise ValueError("bad PPM header")
        tokens.append(int(data[start:pos]))
    w, h, maxval = tokens
    pos += 1                                     # single whitespace byte
    if not (w > 0 and h > 0 and 0 < maxval < 256):
        raise ValueError("unsupported PPM dimensions/maxval")
    pixels = data[pos:pos + w * h * 3]
    if len(pixels) != w * h * 3:
        raise ValueError("truncated PPM")
    return w, h, maxval, pixels


def thumb_diff(a, b):
    """Mean absolute pixel difference of two parsed PPMs, as a fraction 0-1.
    Different sizes (window resized) count as completely different (1.0)."""
    if a[:2] != b[:2] or not a[3]:
        return 1.0
    total = sum(abs(x - y) for x, y in zip(a[3], b[3]))
    return total / (len(a[3]) * max(a[2], b[2]))


def cell_diffs(a, b, grid=None):
    """Per-cell mean absolute difference (0-1) of two parsed PPMs on a
    grid x grid layout, row-major. None when either is missing or the sizes
    differ (resized / other window: not comparable)."""
    if a is None or b is None or a[:2] != b[:2] or not a[3]:
        return None
    grid = grid or SCREEN_GRID
    w, h = a[0], a[1]
    gx, gy = min(grid, w), min(grid, h)
    xs = [(i * w // gx) * 3 for i in range(gx + 1)]     # byte offsets in a row
    ys = [j * h // gy for j in range(gy + 1)]
    pa, pb, row = a[3], b[3], w * 3
    sub, out = operator.sub, []
    for cy in range(gy):
        sums = [0] * gx
        for y in range(ys[cy], ys[cy + 1]):
            off = y * row
            for cx in range(gx):
                s, e = off + xs[cx], off + xs[cx + 1]
                sums[cx] += sum(map(abs, map(sub, pa[s:e], pb[s:e])))
        rows = ys[cy + 1] - ys[cy]
        scale = max(a[2], b[2])
        out += [sums[cx] / (rows * (xs[cx + 1] - xs[cx]) * scale)
                for cx in range(gx)]
    return out


def screen_params(cfg):
    """[screens] settings as numbers; a bad value falls back to the default."""
    out = {}
    for key, conv in (("interval_seconds", float), ("change_threshold", float),
                      ("stable_threshold", float), ("settle_ticks", int),
                      ("cell_change_threshold", float),
                      ("change_fraction", float), ("volatile_ticks", int),
                      ("volatile_window", int), ("max_volatile", float),
                      ("min_gap_seconds", float), ("max_frames", int),
                      ("max_mb", float), ("min_free_mb", float),
                      ("jpeg_quality", int)):
        try:
            out[key] = conv(cfg.get("screens", key))
            if isinstance(out[key], float) and not math.isfinite(out[key]):
                raise ValueError(key)
        except (ValueError, configparser.Error):
            out[key] = conv(DEFAULTS["screens"][key])
    out["interval_seconds"] = max(0.5, out["interval_seconds"])
    out["jpeg_quality"] = min(100, max(1, out["jpeg_quality"]))
    out["volatile_window"] = max(1, out["volatile_window"])
    out["window_class"] = cfg.get("screens", "window_class",
                                  fallback="").strip()
    return out


def screens_enabled(cfg):
    try:
        return cfg.getboolean("screens", "enabled", fallback=True)
    except ValueError:
        return True


SCREEN_KEEP_START = {"hist": (), "vol": (), "stable": 0, "kept": 0,
                     "last_keep": None}


def screen_keep_step(state, d_prev, d_kept, t, p):
    """One tick of the "new and settled" keep rule with a volatile mask.
    Pure; returns (new state, keep).

    d_prev: per-cell diffs (cell_diffs) to the previous tick's thumbnail;
      None = no comparable previous tick (first tick, failed sample, other
      window, resize): the volatility history and settling restart.
    d_kept: per-cell diffs to the last kept frame; None = nothing kept yet
      or not comparable, which counts as new.

    A cell "moved" this tick if its d_prev > stable_threshold. A cell is
    volatile (live camera tile, speaking ring, clock, blinking caret) once
    it moved in >= volatile_ticks of the last volatile_window ticks, and
    stays volatile until it has not moved at all for volatile_window ticks
    (hysteresis: low-motion video must not flicker in and out of the mask).
    Volatile cells are ignored for both decisions:
      settled = no calm cell moved, for settle_ticks ticks in a row;
      new     = >= change_fraction of the calm cells differ from the kept
                frame by > cell_change_threshold, or the calm cells' mean
                difference is >= change_threshold.
    More than max_volatile of the cells volatile (full-window video,
    gallery view) keeps nothing. Then min_gap_seconds / max_frames apply.
    """
    if d_prev is None:
        return dict(state, hist=(), vol=(), stable=0), False
    n = len(d_prev)
    moved = tuple(x > p["stable_threshold"] for x in d_prev)
    hist = tuple(h for h in state["hist"] if len(h) == n) + (moved,)
    hist = hist[-max(1, p["volatile_window"]):]
    old_vol = state["vol"] if len(state["vol"]) == n else (False,) * n
    counts = [sum(h[i] for h in hist) for i in range(n)]
    vol = tuple(c >= p["volatile_ticks"] or (old_vol[i] and c > 0)
                for i, c in enumerate(counts))
    out = dict(state, hist=hist, vol=vol)
    calm = [i for i in range(n) if not vol[i]]
    if not calm or n - len(calm) > p["max_volatile"] * n:
        out["stable"] = 0
        return out, False
    stable = 0 if any(moved[i] for i in calm) else state["stable"] + 1
    out["stable"] = stable
    if d_kept is None or len(d_kept) != n:
        new = True
    else:
        diffs = [d_kept[i] for i in calm]
        differ = sum(1 for x in diffs if x > p["cell_change_threshold"])
        new = (differ >= p["change_fraction"] * len(diffs)
               or sum(diffs) / len(diffs) >= p["change_threshold"])
    gap_ok = (state["last_keep"] is None
              or t - state["last_keep"] >= p["min_gap_seconds"])
    keep = (new and stable >= p["settle_ticks"] and gap_ok
            and state["kept"] < p["max_frames"])
    if keep:
        out.update(kept=state["kept"] + 1, last_keep=t)
    return out, keep


def screen_file_name(offset):
    """Sortable frame file name for an offset in seconds: '00123.4s.jpg'."""
    return f"{max(0.0, offset):07.1f}s.jpg"


def jpeg_size(data):
    """(width, height) from a JPEG's SOF marker, or (0, 0) if not found."""
    i = 2
    while i + 9 < len(data):
        if data[i] != 0xFF:
            i += 1
            continue
        marker = data[i + 1]
        if marker == 0xFF:
            i += 1
            continue
        if marker in (0xD8, 0x01) or 0xD0 <= marker <= 0xD7:
            i += 2
            continue
        seg_len = int.from_bytes(data[i + 2:i + 4], "big")
        if 0xC0 <= marker <= 0xCF and marker not in (0xC4, 0xC8, 0xCC):
            h = int.from_bytes(data[i + 5:i + 7], "big")
            w = int.from_bytes(data[i + 7:i + 9], "big")
            return w, h
        i += 2 + seg_len
    return 0, 0


def moment_segments(segments, t, before=30.0, after=15.0):
    """Segment dicts overlapping [t - before, t + after], in time order."""
    lo, hi = t - before, t + after
    hits = [d for d in segments if d["end"] >= lo and d["start"] <= hi]
    return sorted(hits, key=lambda d: (d["start"], d["end"]))


def render_moments(frames, segments):
    """moments.md: one section per kept frame, with the image and what was
    said from 30 s before to 15 s after it."""
    out = ["# Screen moments", ""]
    for f in sorted(frames, key=lambda f: f["t"]):
        title = " ".join(str(f.get("window_title") or "Screen").split())
        out += [f"## {fmt_ts(f['t'])} — {title}", "",
                f"![screen {fmt_ts(f['t'])}](screens/{f['file']})", ""]
        lines = [format_segment(d["start"], d["end"], " ".join(
            d["text"].split()), d.get("speaker", ""))
            for d in moment_segments(segments, f["t"])]
        out += ["- " + l for l in lines] or ["_No transcript lines around "
                                             "this moment._"]
        out.append("")
    return "\n".join(out)


_SUMMARY_TS = re.compile(r"\[(?:(\d+):)?(\d+):([0-5]\d)\]")


def pick_frame(frames, t, before=90.0, after=15.0):
    """Frame for a summary timestamp: the latest one in [t - before, t],
    else the earliest in (t, t + after]; None if neither exists."""
    earlier = [f for f in frames if t - before <= f["t"] <= t]
    if earlier:
        return max(earlier, key=lambda f: f["t"])
    later = [f for f in frames if t < f["t"] <= t + after]
    return min(later, key=lambda f: f["t"]) if later else None


def link_screens(text, frames):
    """Append a screen link to each summary line ending in a '[mm:ss]'
    reference that has a frame nearby (pick_frame). Idempotent: lines that
    already link a screen are left alone."""
    out = []
    for line in text.splitlines(keepends=True):
        body = line.rstrip("\r\n")
        nl = line[len(body):]
        refs = list(_SUMMARY_TS.finditer(body))
        if refs and "](screens/" not in body:
            h, m, s = refs[-1].groups()
            f = pick_frame(frames, int(h or 0) * 3600 + int(m) * 60 + int(s))
            if f:
                body = (body.rstrip() + f" — [screen {fmt_ts(f['t'])}]"
                        f"(screens/{f['file']})")
        out.append(body + nl)
    return "".join(out)


def load_config(path=None):
    """Load config, merging any existing file over the built-in defaults.

    Missing file -> defaults; partial file -> merged with defaults.
    path defaults to CONFIG_FILE (looked up at call time).
    """
    cfg = configparser.ConfigParser()
    cfg.read_dict(DEFAULTS)
    cfg.read(os.path.expanduser(path or CONFIG_FILE))
    return cfg


def speaker_names(cfg):
    """(me, others) VTT voice names from [speakers]; read raw so a literal
    '%' is fine, and blank names fall back to 'Me' / 'Others'."""
    me = cfg.get("speakers", "me", raw=True, fallback="").strip()
    others = cfg.get("speakers", "others", raw=True, fallback="").strip()
    return me or "Me", others or "Others"


def build_ffmpeg_mix_cmd(sys_wav, mic_wav, out_path,
                         sys_volume, mic_volume, sample_rate):
    """Construct the exact ffmpeg argv list to mix the two raw WAVs."""
    filter_complex = (
        f"[0:a]volume={sys_volume}[a];[1:a]volume={mic_volume}[b];"
        f"[a][b]amix=inputs=2:duration=longest:dropout_transition=2,"
        f"aresample={sample_rate}"
    )
    return [
        "ffmpeg", "-y",
        "-i", sys_wav,
        "-i", mic_wav,
        "-filter_complex", filter_complex,
        "-c:a", "aac", "-b:a", "96k",
        out_path,
    ]


