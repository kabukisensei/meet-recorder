@contextlib.contextmanager
def flock_path(path, timeout=120.0):
    """Exclusive flock on path (a file, created 0600, or a directory) for
    the duration of the with-block. Raises TimeoutError after timeout s."""
    if os.path.isdir(path):
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    else:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_CLOEXEC, 0o600)
    try:
        deadline = time.monotonic() + timeout
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() > deadline:
                    raise TimeoutError(f"{path} is locked by another process")
                time.sleep(0.05)
        yield
    finally:
        os.close(fd)        # releases the lock


_lifecycle_depth = [0]
# How long start/stop wait for another transition (a stop mixing nothing
# but signals, a start's device probes) before reporting "busy".
LOCK_TIMEOUT = 120.0


@contextlib.contextmanager
def lifecycle_lock(timeout=None):
    """Serialize session transitions (start / stop / toggle / stale recovery,
    manual or from the watcher) across processes. Re-entrant within one
    process (toggle -> stop, start -> recover_stale)."""
    if _lifecycle_depth[0]:
        _lifecycle_depth[0] += 1
        try:
            yield
        finally:
            _lifecycle_depth[0] -= 1
        return
    with flock_path(LOCK_FILE, LOCK_TIMEOUT if timeout is None else timeout):
        _lifecycle_depth[0] = 1
        try:
            yield
        finally:
            _lifecycle_depth[0] = 0


def proc_stat(pid):
    """(state letter, process group, start time in clock ticks since boot)
    of a pid from /proc, or None if there is no such process."""
    try:
        with open(f"/proc/{int(pid)}/stat", "rb") as f:
            data = f.read()
        rest = data[data.rindex(b")") + 2:].split()
        return rest[0].decode(), int(rest[2]), int(rest[19])
    except (OSError, ValueError, TypeError, IndexError):
        return None


def proc_start(pid):
    st = proc_stat(pid)
    return st[2] if st else None


def pid_alive(pid, start=None):
    """True if pid is a running (non-zombie) process and, when start is
    given, still the same process (same kernel start time: no PID reuse)."""
    st = proc_stat(pid)
    if st is None or st[0] in ("Z", "X"):
        return False
    return start is None or st[2] == start


def reap(pids=None):
    """Collect exited children (all, or the given pids) so they do not
    linger as zombies; a no-op for processes that are not our children."""
    for pid in ([-1] if pids is None else pids):
        while True:
            try:
                got, _ = os.waitpid(pid, os.WNOHANG)
            except (ChildProcessError, OSError):
                break
            if not got or pid != -1:
                break


def state_procs(state):
    """[(pid, start)] of a session's audio recorders (start None for
    states written before identities were recorded)."""
    starts = (state or {}).get("pid_starts") or {}
    return [(p, starts.get(str(p))) for p in (state or {}).get("pids", [])
            if isinstance(p, int)]


def screens_proc(state):
    pid = (state or {}).get("screens_pid")
    return (pid, state.get("screens_start")) if isinstance(pid, int) else None


def session_live(state):
    return bool(state) and any(pid_alive(p, s) for p, s in state_procs(state))


def send_signal(proc, sig):
    """Signal (pid, start) only if it is still that process. Uses a pidfd
    where possible so the identity check and the signal hit the same
    process. Returns True if sent. Never raises."""
    pid, start = proc
    fd = None
    try:
        try:
            fd = os.pidfd_open(pid)
        except (AttributeError, OSError):
            fd = None
        if not pid_alive(pid, start):
            return False
        if fd is not None:
            signal.pidfd_send_signal(fd, sig)
        else:
            os.kill(pid, sig)
        return True
    except ProcessLookupError:
        return False
    except OSError as e:
        print(f"cannot signal pid {pid}: {e}", file=sys.stderr)
        return False
    finally:
        if fd is not None:
            os.close(fd)


def stop_procs(recorders, worker=None, timeout=5.0):
    """Stop a session's processes; bounded and never raises.

    recorders: [(pid, start)] get SIGINT (pw-record finalizes the WAV).
    worker: (pid, start) of screens-loop gets SIGTERM; its handler kills
    the grim/hyprctl it is running and exits. Only these identity-checked
    processes are ever signalled -- never the worker's process group (a
    group id can be reused). A capture child cannot outlive the worker:
    it gets SIGKILL when the worker dies (CaptureRunner, PR_SET_PDEATHSIG).
    Anything still alive after timeout gets SIGKILL. Processes whose
    identity no longer matches (exited, PID reused) are never signalled.
    """
    live = [p for p in recorders if send_signal(p, signal.SIGINT)]
    if worker and send_signal(worker, signal.SIGTERM):
        live.append(worker)
    ours = [p for p, _ in live]
    deadline = time.monotonic() + timeout
    while True:
        reap(ours)
        live = [p for p in live if pid_alive(*p)]
        if not live:
            return
        if time.monotonic() >= deadline:
            break
        time.sleep(0.1)
    for p in live:
        send_signal(p, signal.SIGKILL)
    time.sleep(0.1)
    reap(ours)


