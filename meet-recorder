def cmd_auto(args=()):
    """auto on|off|toggle|status — whether Teams calls are recorded automatically."""
    cfg = ensure_config()
    want = args[0] if args else "status"
    if want in ("on", "off", "toggle"):
        new = (not auto_enabled(cfg)) if want == "toggle" else want == "on"
        cfg.set("auto", "enabled", "true" if new else "false")
        # Rewrite only the user's own file + this key: writing the merged
        # cfg would freeze every current default (e.g. [screens]
        # thresholds) into config.ini.
        raw = configparser.ConfigParser(interpolation=None)
        raw.read(CONFIG_FILE)
        if not raw.has_section("auto"):
            raw.add_section("auto")
        raw.set("auto", "enabled", "true" if new else "false")
        write_text_atomic(CONFIG_FILE, config_text(raw))
    print("on" if auto_enabled(cfg) else "off")
    return 0


