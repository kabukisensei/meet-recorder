def cmd_start(args=(), source="manual"):
    cfg = ensure_config()
    if "--auto" in args:
        source = "teams"
    state = read_state()
    if state is not None:
        if session_live(state):
            print("Already recording (stop or toggle first).", file=sys.stderr)
            return 1
        recover_stale(state)

    sink = subprocess.check_output(
        ["pactl", "get-default-sink"], text=True).strip()
    mic = subprocess.check_output(
        ["pactl", "get-default-source"], text=True).strip()

    rate = cfg.get("audio", "sample_rate")
    start_unix = int(time.time())
    sess_dir = os.path.join(CACHE_DIR, str(start_unix))
    os.makedirs(sess_dir, exist_ok=True)
    sys_wav = os.path.join(sess_dir, "sys.wav")
    mic_wav = os.path.join(sess_dir, "mic.wav")

    # start_new_session: the recorders must outlive whatever launched us
    # (keybind shell, bar widget, the watch daemon being restarted).
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True)
    # Speaker side: capture the sink itself. (PipeWire has no "<sink>.monitor"
    # node -- targeting that name silently falls back to the microphone.)
    # With no --target the recorders follow the system default devices, so
    # plugging in / switching to headphones mid-call keeps recording. Only
    # when the call app was pointed at a non-default device do we pin to it.
    apps = auto_apps(cfg)
    pin_sink = app_device(
        run_json(["pactl", "-f", "json", "list", "sink-inputs"], []),
        run_json(["pactl", "-f", "json", "list", "sinks"], []),
        apps, "sink", sink)
    pin_mic = app_device(
        run_json(["pactl", "-f", "json", "list", "source-outputs"], []),
        run_json(["pactl", "-f", "json", "list", "sources"], []),
        apps, "source", mic)
    sink, mic = pin_sink or sink, pin_mic or mic
    base = ["pw-record", "--channels", "1", "--rate", rate]
    p_sys = subprocess.Popen(
        base + ["-P", "{ stream.capture.sink = true }"]
        + (["--target", pin_sink] if pin_sink else []) + [sys_wav], **quiet)
    p_mic = subprocess.Popen(
        base + (["--target", pin_mic] if pin_mic else []) + [mic_wav], **quiet)
    title = meeting_title(cfg)
    write_state({"pids": [p_sys.pid, p_mic.pid], "start": start_unix,
                 "session_dir": sess_dir, "sys_wav": sys_wav, "mic_wav": mic_wav,
                 "source": source, "title": title, "sink": sink, "mic": mic})
    time.sleep(0.4)
    if not (pid_alive(p_sys.pid) and p_sys.poll() is None
            and pid_alive(p_mic.pid) and p_mic.poll() is None):
        terminate([p_sys.pid, p_mic.pid], timeout=1)
        clear_state()
        notify("Meeting recorder: could not start",
               "pw-record failed to open the speaker or microphone.")
        print("failed to start recorders", file=sys.stderr)
        return 1
    if screens_enabled(cfg):
        screens_pid = spawn_screens(sess_dir)
        if screens_pid:
            state = read_state() or {}
            state["screens_pid"] = screens_pid
            write_state(state)
    notify("● Recording started",
           (title or ("Teams call" if source == "teams" else "Manual recording"))
           + "\nStop: click the mic icon in the bar, or Super+Shift+R")
    print("recording")
    return 0


def transcribe(paths, cfg):
    """Lazily import faster-whisper; transcribe each path with one model.

    Returns a list of (segments, duration), one per path.
    """
    try:
        from faster_whisper import WhisperModel
    except ImportError:
        print("faster-whisper is not installed. Install it in your venv:\n"
              "    pip install faster-whisper", file=sys.stderr)
        sys.exit(3)
    model = WhisperModel(cfg.get("whisper", "model"),
                         device=cfg.get("whisper", "device"),
                         compute_type=cfg.get("whisper", "compute_type"))
    results = []
    for path in paths:
        segments, info = model.transcribe(
            path, beam_size=cfg.getint("whisper", "beam_size"), vad_filter=True)
        results.append(([(s.start, s.end, s.text) for s in segments],
                        getattr(info, "duration", 0.0)))
    return results


def write_vtt(folder, seg_dicts, cfg):
    """Write transcript.vtt (FocusTime / Teams format); returns its path.

    The VTT is rendered fully before anything touches the destination, then
    published atomically (UTF-8), so a bad segment never erases a good file.
    """
    text = segments_to_vtt(seg_dicts, *speaker_names(cfg))
    path = os.path.join(folder, "transcript.vtt")
    write_text_atomic(path, text)
    return path


def write_transcripts(folder, segments, start_unix, duration, title="",
                      cfg=None):
    """Write transcript.txt/.md, then the FocusTime exports.

    The legacy transcripts are written first and their failure raises. An
    export failure (segments.json / transcript.vtt) does not: it is returned
    as an error string (None on success) so the caller can report it and the
    user can retry with `meet-recorder export <folder>`.
    """
    lines = [format_segment(*seg) for seg in segments]
    body = "\n".join(lines) + ("\n" if lines else "")
    with open(os.path.join(folder, "transcript.txt"), "w") as f:
        f.write(body)
    iso = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(start_unix))
    with open(os.path.join(folder, "transcript.md"), "w") as f:
        f.write(f"# {title or 'Meeting'} {iso}\n\n")
        f.write(f"Duration: {fmt_ts(duration)}\n\n")
        f.write(body if body else MD_NO_SPEECH + "\n")
    seg_path = os.path.join(folder, "segments.json")
    try:
        seg_dicts = segment_dicts(segments)
        try:
            write_json(seg_path, seg_dicts)
        except Exception:
            # The old segments.json now describes the previous transcript;
            # never leave it for `export` to trust.
            try:
                os.remove(seg_path)
            except OSError:
                pass
            raise
        write_vtt(folder, seg_dicts, cfg or load_config())
    except Exception as e:
        return f"{type(e).__name__}: {e}"
    return None


def finalize_audio(state, cfg):
    """Mix the raw tracks into the output folder; returns the folder path."""
    sys_wav, mic_wav = state["sys_wav"], state["mic_wav"]
    start_unix = state["start"]
    sess_dir = state["session_dir"]
    have = [w for w in (sys_wav, mic_wav)
            if os.path.exists(w) and os.path.getsize(w) > 1024]
    if not have:
        raise RuntimeError("no audio was captured")

    source = state.get("source", "manual")
    title = state.get("title", "")
    slug = "-".join(x for x in (source, slugify(title)) if x) or "meeting"
    out_base = os.path.expanduser(cfg.get("paths", "output_dir"))
    day = time.strftime("%Y-%m-%d", time.localtime(start_unix))
    folder = os.path.join(out_base, day, session_dir_name(start_unix, slug))
    os.makedirs(folder, exist_ok=True)
    final_m4a = os.path.join(folder, "meeting.m4a")

    if len(have) == 2:
        cmd = build_ffmpeg_mix_cmd(
            sys_wav, mic_wav, final_m4a,
            cfg.getfloat("audio", "sys_volume"),
            cfg.getfloat("audio", "mic_volume"),
            cfg.getint("audio", "sample_rate"))
    else:  # one track is missing/empty: keep what we have
        cmd = ["ffmpeg", "-y", "-i", have[0], "-c:a", "aac", "-b:a", "96k",
               final_m4a]
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL)
    subprocess.run(cmd, check=True, **quiet)
    # Keep each side as its own small file so the transcript can say who spoke.
    for wav, name in ((mic_wav, "me.m4a"), (sys_wav, "others.m4a")):
        if wav in have:
            subprocess.run(["ffmpeg", "-y", "-i", wav, "-c:a", "aac", "-b:a",
                            "48k", os.path.join(folder, name)],
                           check=False, **quiet)

    n_screens = collect_screens(sess_dir, folder)
    # Raw WAVs are disposable once the mix succeeds.
    shutil.rmtree(sess_dir, ignore_errors=True)

    write_json(os.path.join(folder, "meta.json"), {
        "started": time.strftime("%Y-%m-%dT%H:%M:%S%z",
                                 time.localtime(start_unix)),
        "source": source, "title": title,
        "tracks": [os.path.basename(w) for w in have],
        "speaker_device": state.get("sink", ""),
        "mic_device": state.get("mic", ""),
        "audio": "meeting.m4a", "transcript": "transcript.md",
        "transcript_status": "pending",
        "screens": n_screens,
    })
    return folder


def read_screens_jsonl(raw_dir):
    """Frames recorded by screens-loop whose image exists, sorted by t.
    Tolerates a torn last line (the loop may be killed mid-write)."""
    frames = []
    try:
        with open(os.path.join(raw_dir, "screens.jsonl"), encoding="utf-8") as f:
            lines = f.readlines()
    except OSError:
        return frames
    for line in lines:
        try:
            d = json.loads(line)
            float(d["t"])
        except (ValueError, KeyError, TypeError):
            continue
        if (isinstance(d.get("file"), str) and "/" not in d["file"]
                and os.path.isfile(os.path.join(raw_dir, "screens", d["file"]))):
            frames.append(d)
    return sorted(frames, key=lambda d: d["t"])


def collect_screens(raw_dir, folder):
    """Move kept frames into <folder>/screens/ and write screens.json.
    Returns the frame count; never raises (screens must not cost audio)."""
    try:
        frames = read_screens_jsonl(raw_dir)
        if frames:
            dest = os.path.join(folder, "screens")
            os.makedirs(dest, exist_ok=True)
            for d in frames:
                shutil.move(os.path.join(raw_dir, "screens", d["file"]),
                            os.path.join(dest, d["file"]))
            write_json(os.path.join(folder, "screens.json"), frames)
        log = os.path.join(raw_dir, "screens.log")
        if os.path.exists(log) and os.path.getsize(log):
            shutil.move(log, os.path.join(folder, "screens.log"))
        return len(frames)
    except Exception as e:
        print(f"collecting screens failed: {e}", file=sys.stderr)
        return 0


def spawn_screens(sess_dir):
    """Start the detached screens-loop for a raw session dir; pid or None."""
    try:
        log = open(os.path.join(sess_dir, "screens.log"), "a")
        p = subprocess.Popen([sys.executable, os.path.abspath(__file__),
                              "screens-loop", sess_dir],
                             stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                             start_new_session=True)
        log.close()
        return p.pid
    except OSError:
        return None


def load_folder_segments(folder):
    """Segment dicts for a session folder (folder_segments), else []."""
    try:
        return folder_segments(folder)[0]
    except (OSError, ValueError):
        return []


def read_frames(folder):
    """screens.json of a session folder ([] if missing or malformed)."""
    frames = read_json(os.path.join(folder, "screens.json"))
    if not isinstance(frames, list):
        return []
    return [f for f in frames if isinstance(f, dict)
            and isinstance(f.get("t"), (int, float)) and isinstance(f.get("file"), str)]


def write_moments(folder, segments):
    """Write moments.md if the folder has screen frames; returns its path
    (None when there are no frames)."""
    frames = read_frames(folder)
    if not frames:
        return None
    path = os.path.join(folder, "moments.md")
    write_text_atomic(path, render_moments(frames, segments))
    return path


def spawn_summary(cmd, folder):
    """Run the optional post-transcription summarizer detached; never block
    or fail the recording pipeline if it errors."""
    log = open(os.path.join(folder, "summary.log"), "w")
    subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)


def spawn_transcribe(folder):
    """Transcribe in a detached process so nothing that launched us can kill it."""
    log = open(os.path.join(folder, "transcribe.log"), "w")
    subprocess.Popen([sys.executable, os.path.abspath(__file__),
                      "transcribe", folder],
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True)


def recover_stale(state):
    """A previous session died (crash/reboot) — save whatever audio it left."""
    clear_state()
    try:
        folder = finalize_audio(state, ensure_config())
    except Exception:
        return
    spawn_transcribe(folder)
    notify("Meeting recorder", "Recovered an interrupted recording:\n" + folder)


def cmd_stop(args=()):
    cfg = ensure_config()
    state = read_state()
    if state is None:
        print("Not recording.", file=sys.stderr)
        return 1
    pids = list(state.get("pids", []))
    if isinstance(state.get("screens_pid"), int):
        pids.append(state["screens_pid"])
    try:
        terminate(pids)
    finally:
        clear_state()
    try:
        folder = finalize_audio(state, cfg)
    except Exception as e:
        notify("Meeting recorder: saving failed", str(e))
        print(f"saving failed: {e}", file=sys.stderr)
        return 1
    write_json(LAST_FILE, {"folder": folder, "status": "transcribing"})
    spawn_transcribe(folder)
    notify("Recording saved — transcribing…", folder)
    print(folder)
    return 0


def cmd_transcribe(args=()):
    """Transcribe (or re-transcribe) a session folder's meeting.m4a."""
    if not args:
        print("usage: meet-recorder transcribe <session-folder>", file=sys.stderr)
        return 2
    cfg = ensure_config()
    folder = os.path.abspath(os.path.expanduser(args[0]))
    audio = os.path.join(folder, "meeting.m4a")
    meta_path = os.path.join(folder, "meta.json")
    meta = read_json(meta_path) or {}
    marker = os.path.join(JOBS_DIR, f"{os.getpid()}.json")
    write_json(marker, {"pid": os.getpid(), "folder": folder})
    status = "failed"
    try:
        me_audio = os.path.join(folder, "me.m4a")
        others_audio = os.path.join(folder, "others.m4a")
        if os.path.exists(me_audio) and os.path.exists(others_audio):
            (me, d1), (others, d2) = transcribe([me_audio, others_audio], cfg)
            segments, duration = merge_speakers(me, others), max(d1, d2)
            meta["speaker_labels"] = True
        else:
            [(segments, duration)] = transcribe([audio], cfg)
        start = os.path.getmtime(audio) - duration
        try:
            start = time.mktime(time.strptime(meta["started"][:19],
                                              "%Y-%m-%dT%H:%M:%S"))
        except (KeyError, ValueError):
            pass
        export_err = write_transcripts(folder, segments, start, duration,
                                       meta.get("title", ""), cfg)
        status = "done" if segments else "no-speech"
        try:
            write_moments(folder, segment_dicts(segments))
        except Exception as e:   # never fails the transcription
            print(f"moments.md failed: {e}\nretry: meet-recorder moments "
                  f"{folder}", file=sys.stderr)
        if export_err:
            # transcript.md/.txt are fine; only the FocusTime files failed.
            print(f"export failed: {export_err}\n"
                  f"retry: meet-recorder export {folder}", file=sys.stderr)
            notify("Meeting recorder: FocusTime export failed",
                   f"{export_err}\nTranscript is fine. Retry: "
                   f"meet-recorder export {folder}")
        summary_cmd = cfg.get("summary", "summary_cmd", fallback="").strip()
        if status == "done" and summary_cmd:
            spawn_summary(summary_cmd.format(folder=folder), folder)
        meta.update({"duration_seconds": round(duration),
                     "whisper_model": cfg.get("whisper", "model")})
        notify("Transcript ready" if segments else "Recording saved (no speech found)",
               folder)
    except Exception as e:
        notify("Meeting recorder: transcription failed",
               f"{e}\nAudio is safe in {folder}")
        raise
    finally:
        meta["transcript_status"] = status
        write_json(meta_path, meta)
        last = read_json(LAST_FILE) or {}
        if last.get("folder") == folder:
            write_json(LAST_FILE, {"folder": folder, "status": status})
        try:
            os.remove(marker)
        except OSError:
            pass
    print(folder)
    return 0


def cmd_export(args=()):
    """Backfill transcript.vtt (+ segments.json) for existing session folders."""
    if not args:
        print("usage: meet-recorder export <session-folder> [<folder>...]",
              file=sys.stderr)
        return 2
    cfg = load_config()
    rc = 0
    for arg in args:
        folder = os.path.abspath(os.path.expanduser(arg))
        try:
            print(export_folder(folder, cfg))
        except (OSError, ValueError, ArithmeticError) as e:
            print(f"{folder}: export failed: {e}", file=sys.stderr)
            rc = 1
    return rc


def export_folder(folder, cfg):
    """Build transcript.vtt (and segments.json if missing) for one folder.

    Source: segments.json when present and non-empty; otherwise
    transcript.md (an empty segments.json is only trusted when the markdown
    also says no speech). Speaker labels in the markdown are honoured per
    meta.json's speaker_labels; folders without meta.json fall back to the
    'Me: ' / 'Others: ' prefix heuristic. Raises OSError / ValueError.
    """
    if not os.path.isdir(folder):
        raise FileNotFoundError(f"not a folder: {folder}")
    segs, from_md = folder_segments(folder)
    if from_md:
        write_json(os.path.join(folder, "segments.json"), segs)
    return write_vtt(folder, segs, cfg)


def folder_segments(folder):
    """(segment dicts, from_md) for a session folder.

    segments.json is trusted only when it is valid, non-empty and not older
    than transcript.md (a failed refresh after a re-transcription must not
    resurrect the previous transcript); otherwise transcript.md is parsed.
    Without transcript.md, segments.json errors are raised as they are.
    Raises OSError / ValueError.
    """
    seg_path = os.path.join(folder, "segments.json")
    md_path = os.path.join(folder, "transcript.md")
    try:
        md_mtime = os.stat(md_path).st_mtime_ns
    except FileNotFoundError:
        md_mtime = None
    if os.path.exists(seg_path):
        try:
            if md_mtime is not None and os.stat(seg_path).st_mtime_ns < md_mtime:
                raise ValueError("segments.json is older than transcript.md")
            with open(seg_path, encoding="utf-8") as f:
                segs = validate_segments(json.load(f))
            if segs or md_mtime is None:
                return segs, False
        except (OSError, ValueError):
            if md_mtime is None:
                raise
    if md_mtime is None:
        raise FileNotFoundError("no segments.json or transcript.md to export")
    meta = read_json(os.path.join(folder, "meta.json"))
    labels = bool(meta.get("speaker_labels")) if isinstance(meta, dict) else None
    with open(md_path, encoding="utf-8") as f:
        return parse_md_transcript(f.read(), labels), True


def grab_thumb(stable_id, width, env):
    """Tiny PPM thumbnail of one window via grim -T (works off-screen)."""
    scale = min(1.0, SCREEN_THUMB_WIDTH / max(1, width))
    out = subprocess.run(["grim", "-T", stable_id, "-s", f"{scale:.4f}",
                          "-t", "ppm", "-"], capture_output=True, timeout=10,
                         env=env)
    if out.returncode != 0:
        raise RuntimeError("grim thumbnail failed: "
                           + out.stderr.decode(errors="replace").strip())
    return parse_ppm(out.stdout)


def grab_frame(stable_id, path, quality, env):
    """Full-resolution JPEG of one window, published atomically."""
    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))
    out = subprocess.run(["grim", "-T", stable_id, "-t", "jpeg",
                          "-q", str(quality), tmp], capture_output=True,
                         timeout=20, env=env)
    if out.returncode != 0 or not os.path.exists(tmp):
        raise RuntimeError("grim capture failed: "
                           + out.stderr.decode(errors="replace").strip())
    with open(tmp, "rb") as f:
        w, h = jpeg_size(f.read(65536))
    os.replace(tmp, path)
    return w, h


def cmd_screens_loop(args=()):
    """Hidden: capture "new and settled" frames of the call window into
    <raw>/screens/ until the session ends (spawned by start, stopped by stop)."""
    if not args:
        print("usage: meet-recorder screens-loop <session-raw-dir>",
              file=sys.stderr)
        return 2
    raw = os.path.abspath(args[0])
    shots = os.path.join(raw, "screens")
    os.makedirs(shots, exist_ok=True)
    try:
        start = float(os.path.basename(raw))
    except ValueError:
        start = time.time()
    p = screen_params(load_config())
    env = hypr_env()
    try:
        os.nice(10)
    except OSError:
        pass

    stop = []
    for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda *_: stop.append(1))

    last_err = [None]

    def log(msg):
        """Log to screens.log; repeated identical errors are logged once."""
        if msg == last_err[0]:
            return
        last_err[0] = msg
        with open(os.path.join(raw, "screens.log"), "a") as f:
            f.write(time.strftime("%H:%M:%S ") + msg + "\n")

    keep_state, prev, kept_thumb, orphan = dict(SCREEN_KEEP_START), None, None, 0
    prev_sid = None
    next_tick = time.monotonic()
    while not stop:
        # Exit when the session is over (stop, crash recovery, finalize).
        state = read_state()
        same = bool(state) and state.get("session_dir") == raw
        orphan = 0 if same else orphan + 1
        if not os.path.isdir(raw) or orphan >= 2:
            break
        try:
            clients = run_json(["hyprctl", "clients", "-j"], None)
            if clients is None:
                prev = None
                raise RuntimeError("hyprctl clients failed")
            win = pick_screen_window(clients, p["window_class"])
            if win is None:
                prev = None
                log(f"no window of class {p['window_class']!r}")
            else:
                sid = str(win["stableId"])
                if sid != prev_sid:
                    prev, prev_sid = None, sid
                try:
                    thumb = grab_thumb(sid, (win.get("size") or [0])[0], env)
                except Exception:
                    prev = None
                    raise
                t = time.time() - start
                d_prev = cell_diffs(prev, thumb)
                d_kept = cell_diffs(kept_thumb, thumb)
                prev = thumb
                new_state, keep = screen_keep_step(keep_state, d_prev, d_kept,
                                                   t, p)
                keep_state = dict(new_state, kept=keep_state["kept"],
                                  last_keep=keep_state["last_keep"])
                if keep:
                    name = screen_file_name(t)
                    w, h = grab_frame(sid, os.path.join(shots, name),
                                      p["jpeg_quality"], env)
                    keep_state, kept_thumb = new_state, thumb
                    with open(os.path.join(raw, "screens.jsonl"), "a",
                              encoding="utf-8") as f:
                        f.write(json.dumps({
                            "t": round(t, 1), "file": name,
                            "window_title": clean_window_title(
                                win.get("title", "")),
                            "w": w, "h": h}) + "\n")
                last_err[0] = None
        except Exception as e:      # never let a bad tick end the loop
            log(f"{type(e).__name__}: {e}")
        next_tick += p["interval_seconds"]
        now = time.monotonic()
        if next_tick < now:          # fell behind (suspend etc.): resync
            next_tick = now + p["interval_seconds"]
        while not stop and time.monotonic() < next_tick:
            time.sleep(min(0.25, max(0.0, next_tick - time.monotonic())))
    return 0


