def cmd_toggle(args=()):
    cfg = ensure_config()
    stale = []
    try:
        with lifecycle_lock():          # decide and act as one transition
            if session_live(read_state()):
                stopped, rc = stop_locked(), None
            else:
                stopped, rc = None, start_locked(cfg, "manual", stale)
    except TimeoutError as e:
        print(f"busy: {e}", file=sys.stderr)
        return BUSY
    finally:            # mixing a crashed session: lock released, always
        finish_stale(stale, cfg)
    if rc is not None:
        return rc
    return finish_session(stopped, cfg) if stopped else 1


