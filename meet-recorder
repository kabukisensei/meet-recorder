# Exit code of start/stop/toggle when another transition holds the lock
# (EX_TEMPFAIL): the watcher retries instead of treating the call as handled.
BUSY = 75
# Exit code of start when a device probe failed transiently (pactl timed
# out / failed, e.g. PipeWire restarting): the watcher retries it a bounded
# number of times while the call lasts.
RETRY = 76


def cmd_start(args=(), source="manual"):
    cfg = ensure_config()
    if "--auto" in args:
        source = "teams"
    stale = []
    try:
        with lifecycle_lock():
            rc = start_locked(cfg, source, stale)
    except TimeoutError as e:
        print(f"busy: {e}", file=sys.stderr)
        return BUSY
    finally:
        finish_stale(stale, cfg)
    return rc


def finish_stale(stale, cfg):
    """Mix crashed sessions that start/toggle recovered (with the lock
    released) -- also when the new start failed or raised: recovery already
    cleared them from session.json, nothing else would ever save them."""
    for state in stale:
        finish_session(state, cfg, recovered=True)


def start_settings(cfg):
    """Every setting start needs, resolved BEFORE anything is spawned: a
    malformed value must fail the start, never strand running recorders."""
    rate = str(int(cfg.get("audio", "sample_rate")))
    return {"rate": rate, "apps": auto_apps(cfg),
            "screens": screens_enabled(cfg),
            "mic_source": mic_source_setting(
                cfg.get("audio", "mic_source", raw=True, fallback="auto"))}


def pactl_default(kind):
    """`pactl get-default-<kind>`, bounded (it runs under the lifecycle
    lock: a hung pactl must not block every other transition)."""
    return subprocess.check_output(["pactl", f"get-default-{kind}"], text=True,
                                   timeout=5,
                                   stdin=subprocess.DEVNULL).strip()


def start_locked(cfg, source, stale=None):
    """cmd_start body; runs under lifecycle_lock. session.json is published
    once, complete (recorders verified, screens worker attached), so no
    other start/stop/watcher can see or clobber a half-made session.
    A crashed previous session is stopped and cleared here and appended to
    `stale` for the caller to finalize after releasing the lock."""
    state = read_state()
    if state is not None:
        if session_live(state):
            print("Already recording (stop or toggle first).", file=sys.stderr)
            return 1
        old = recover_stale(state)
        if stale is not None:
            stale.append(old)
        else:
            finish_session(old, cfg, recovered=True)

    try:
        settings = start_settings(cfg)
    except (ValueError, configparser.Error) as e:
        notify("Meeting recorder: could not start", str(e))
        print(f"cannot start: {e}", file=sys.stderr)
        return 1
    try:
        sink, mic = pactl_default("sink"), pactl_default("source")
    except subprocess.SubprocessError as e:     # timed out / failed: transient
        if source != "teams":       # the watcher notifies when it gives up
            notify("Meeting recorder: could not start", str(e))
        print(f"cannot start (will retry): {e}", file=sys.stderr)
        return RETRY
    except OSError as e:
        notify("Meeting recorder: could not start", str(e))
        print(f"cannot start: {e}", file=sys.stderr)
        return 1
    rate = settings["rate"]
    # start_new_session: the recorders must outlive whatever launched us
    # (keybind shell, bar widget, the watch daemon being restarted).
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True)
    # Speaker side: capture the sink itself. (PipeWire has no "<sink>.monitor"
    # node -- targeting that name silently falls back to the microphone.)
    # With no --target the recorders follow the system default devices, so
    # plugging in / switching to headphones mid-call keeps recording. Only
    # when the call app was pointed at a non-default device do we pin to it.
    apps = settings["apps"]
    pin_sink = app_device(
        run_json(["pactl", "-f", "json", "list", "sink-inputs"], []),
        run_json(["pactl", "-f", "json", "list", "sinks"], []),
        apps, "sink", sink)
    sources = run_json(["pactl", "-f", "json", "list", "sources"], [])
    pin_mic = app_device(
        run_json(["pactl", "-f", "json", "list", "source-outputs"], []),
        sources, apps, "source", mic)
    # Mic: the echo-cancelled source when it is there (the far side played
    # through speakers is removed from me.m4a), else as before.
    mic_target, echo, mic_note = pick_mic_source(settings["mic_source"],
                                                 sources, pin_mic)
    print(f"mic: {mic_note}", file=sys.stderr)
    sink, mic = pin_sink or sink, pin_mic or mic
    title = meeting_title(cfg)

    # Unique per session: the raw dir and the id the screens worker checks.
    session_id = f"{int(time.time())}-{os.urandom(3).hex()}"
    sess_dir = os.path.join(CACHE_DIR, session_id)
    sys_wav = os.path.join(sess_dir, "sys.wav")
    mic_wav = os.path.join(sess_dir, "mic.wav")
    # With AEC the raw mic is recorded too: finalize falls back to it if
    # the AEC track turns out silent/stalled, so AEC can never cost audio.
    mic_raw_wav = os.path.join(sess_dir, "mic-raw.wav") if echo else ""
    base = ["pw-record", "--channels", "1", "--rate", rate]
    argvs = [base + ["-P", "{ stream.capture.sink = true }"]
             + (["--target", pin_sink] if pin_sink else []) + [sys_wav],
             base + (["--target", mic_target] if mic_target else [])
             + [mic_wav]]
    if echo:
        argvs.append(base + (["--target", pin_mic] if pin_mic else [])
                     + [mic_raw_wav])
    procs, worker = [], None
    # Everything from the first spawn to the published state is one unit:
    # any failure (or exception) stops what was spawned and removes the raw
    # dir, so nothing runs untracked by session.json.
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        make_private_dir(sess_dir)      # call audio + screenshots: 0700
        # Taken immediately before audio starts (after all the slow probes):
        # wall time names the folder, the monotonic origin times the frames.
        start_unix, origin = int(time.time()), time.monotonic()
        children = []
        for argv in argvs:
            p = subprocess.Popen(argv, **quiet)
            children.append(p)
            procs.append((p.pid, proc_start(p.pid)))
        time.sleep(0.4)
        # The speaker side plus at least one mic recorder must be up (a
        # dead AEC recorder is fine while the raw-mic one runs: finalize
        # then uses the raw track).
        if (children[0].poll() is not None
                or all(p.poll() is not None for p in children[1:])):
            raise RuntimeError("pw-record failed to open the speaker or "
                               "microphone.")
        state = {"id": session_id, "pids": [p for p, _ in procs],
                 "pid_starts": {str(p): s for p, s in procs},
                 "start": start_unix, "origin": origin,
                 "session_dir": sess_dir, "sys_wav": sys_wav,
                 "mic_wav": mic_wav, "source": source, "title": title,
                 "sink": sink, "mic": mic, "mic_source": mic_target,
                 "mic_echo_cancel": echo}
        if echo:
            state["mic_raw_wav"] = mic_raw_wav
        if settings["screens"]:
            worker = spawn_screens(sess_dir, session_id, origin)
            if worker:
                state["screens_pid"], state["screens_start"] = worker
        write_state(state)
    except BaseException as e:
        stop_procs(procs, worker, timeout=1)
        shutil.rmtree(sess_dir, ignore_errors=True)
        if not isinstance(e, Exception):
            raise
        notify("Meeting recorder: could not start", str(e))
        print(f"failed to start: {e}", file=sys.stderr)
        return 1
    notify("● Recording started",
           (title or ("Teams call" if source == "teams" else "Manual recording"))
           + "\nStop: click the mic icon in the bar, or Super+Shift+R")
    print("recording")
    return 0


def transcribe(paths, cfg):
    """Lazily import faster-whisper; transcribe each path with one model.

    Returns a list of (segments, duration), one per path.
    """
    try:
        from faster_whisper import WhisperModel
    except ImportError:
        print("faster-whisper is not installed. Install it in your venv:\n"
              "    pip install faster-whisper", file=sys.stderr)
        sys.exit(3)
    options = whisper_options(cfg)      # a bad value fails before the load
    model = WhisperModel(cfg.get("whisper", "model"),
                         device=cfg.get("whisper", "device"),
                         compute_type=cfg.get("whisper", "compute_type"))
    results = []
    for path in paths:
        segments, info = model.transcribe(path, **options)
        results.append(([(s.start, s.end, s.text) for s in segments],
                        getattr(info, "duration", 0.0)))
    return results


def write_vtt(folder, seg_dicts, cfg):
    """Write transcript.vtt (FocusTime / Teams format); returns its path.

    The VTT is rendered fully before anything touches the destination, then
    published atomically (UTF-8), so a bad segment never erases a good file.
    """
    text = segments_to_vtt(seg_dicts, *speaker_names(cfg))
    path = os.path.join(folder, "transcript.vtt")
    write_text_atomic(path, text)
    return path


def write_transcripts(folder, segments, start_unix, duration, title="",
                      cfg=None):
    """Write transcript.txt/.md, then the FocusTime exports.

    The legacy transcripts are written first and their failure raises. An
    export failure (segments.json / transcript.vtt) does not: it is returned
    as an error string (None on success) so the caller can report it and the
    user can retry with `meet-recorder export <folder>`.
    """
    lines = [format_segment(*seg) for seg in segments]
    body = "\n".join(lines) + ("\n" if lines else "")
    # Atomic, so the screens collector building moments.md concurrently
    # never parses half a transcript.
    write_text_atomic(os.path.join(folder, "transcript.txt"), body)
    iso = time.strftime("%Y-%m-%dT%H:%M:%S", time.localtime(start_unix))
    write_text_atomic(os.path.join(folder, "transcript.md"),
                      f"# {title or 'Meeting'} {iso}\n\n"
                      f"Duration: {fmt_ts(duration)}\n\n"
                      + (body if body else MD_NO_SPEECH + "\n"))
    seg_path = os.path.join(folder, "segments.json")
    try:
        seg_dicts = segment_dicts(segments)
        try:
            write_json(seg_path, seg_dicts)
        except Exception:
            # The old segments.json now describes the previous transcript;
            # never leave it for `export` to trust.
            try:
                os.remove(seg_path)
            except OSError:
                pass
            raise
        write_vtt(folder, seg_dicts, cfg or load_config())
    except Exception as e:
        return f"{type(e).__name__}: {e}"
    return None


def wav_stats(path):
    """{'seconds', 'peak'} of a WAV, or None if missing/tiny/unreadable.
    peak (max |sample|) only for 16-bit audio, else None. Reads in chunks
    (an hour of 16 kHz mono is ~115 MB)."""
    import array
    import wave
    try:
        if os.path.getsize(path) <= 1024:
            return None
        with wave.open(path, "rb") as w:
            rate, width = w.getframerate(), w.getsampwidth()
            frames, peak = w.getnframes(), (0 if width == 2 else None)
            if peak is not None:
                while True:
                    chunk = w.readframes(1 << 18)
                    if not chunk:
                        break
                    a = array.array("h")
                    a.frombytes(chunk[:len(chunk) // 2 * 2])
                    if sys.byteorder == "big":
                        a.byteswap()
                    if a:
                        peak = max(peak, max(a), -min(a))
    except (OSError, EOFError, wave.Error):
        return None
    if not frames or not rate:
        return None
    return {"seconds": frames / rate, "peak": peak}


def choose_mic_wav(state):
    """(mic WAV to use, echo_cancel) for a stopped session. Sessions
    recorded with AEC also have the raw mic; see pick_mic_track."""
    mic_wav, raw = state["mic_wav"], state.get("mic_raw_wav")
    if not (state.get("mic_echo_cancel") and raw):
        return mic_wav, bool(state.get("mic_echo_cancel"))
    if pick_mic_track(wav_stats(mic_wav), wav_stats(raw)) == "raw":
        print("echo-cancelled mic track unusable; using the raw mic",
              file=sys.stderr)
        return raw, False
    return mic_wav, True


def finalize_audio(state, cfg):
    """Mix the raw tracks into the output folder; returns the folder path."""
    sys_wav = state["sys_wav"]
    mic_wav, echo = choose_mic_wav(state)
    start_unix = state["start"]
    have =[w for w in (sys_wav, mic_wav)
            if os.path.exists(w) and os.path.getsize(w) > 1024]
    if not have:
        raise RuntimeError("no audio was captured")

    source = state.get("source", "manual")
    title = state.get("title", "")
    slug = "-".join(x for x in (source, slugify(title)) if x) or "meeting"
    out_base = os.path.expanduser(cfg.get("paths", "output_dir"))
    day = time.strftime("%Y-%m-%d", time.localtime(start_unix))
    folder = os.path.join(out_base, day, session_dir_name(start_unix, slug))
    os.makedirs(folder, exist_ok=True)
    final_m4a = os.path.join(folder, "meeting.m4a")

    if len(have) == 2:
        cmd = build_ffmpeg_mix_cmd(
            sys_wav, mic_wav, final_m4a,
            cfg.getfloat("audio", "sys_volume"),
            cfg.getfloat("audio", "mic_volume"),
            cfg.getint("audio", "sample_rate"))
    else:  # one track is missing/empty: keep what we have
        cmd = ["ffmpeg", "-y", "-i", have[0], "-c:a", "aac", "-b:a", "96k",
               final_m4a]
    quiet = dict(stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL)
    subprocess.run(cmd, check=True, **quiet)
    # Keep each side as its own small file so the transcript can say who spoke.
    for wav, name in ((mic_wav, "me.m4a"), (sys_wav, "others.m4a")):
        if wav in have:
            subprocess.run(["ffmpeg", "-y", "-i", wav, "-c:a", "aac", "-b:a",
                            "48k", os.path.join(folder, name)],
                           check=False, **quiet)

    # Raw WAVs are disposable once the mix succeeds. Nothing here reads
    # screen data: the raw dir (frames, manifest, log) belongs to the
    # separate collect-screens job, which also removes it, so no screen
    # problem can delay or fail the audio or the transcription.
    for wav in filter(None, {sys_wav, state["mic_wav"],
                             state.get("mic_raw_wav")}):
        try:
            os.remove(wav)
        except OSError:
            pass

    write_json(os.path.join(folder, "meta.json"), {
        "started": time.strftime("%Y-%m-%dT%H:%M:%S%z",
                                 time.localtime(start_unix)),
        "source": source, "title": title,
        "tracks": [os.path.basename(w) for w in have],
        "speaker_device": state.get("sink", ""),
        "mic_device": state.get("mic", ""),
        "mic_echo_cancel": echo and mic_wav in have,
        "audio": "meeting.m4a", "transcript": "transcript.md",
        "transcript_status": "pending",
    })
    return folder


def read_screens_jsonl(raw_dir):
    """Frames recorded by screens-loop whose image exists, sorted by t.
    Tolerates a torn last line (the loop may be killed mid-write). A missing
    manifest is [] (nothing was kept); any other read error RAISES: an
    unreadable manifest is not an empty one (the collector would otherwise
    delete frames it never copied)."""
    try:
        with open(os.path.join(raw_dir, "screens.jsonl"), encoding="utf-8",
                  errors="replace") as f:
            lines = f.readlines()
    except FileNotFoundError:
        return []
    out = []
    for line in lines:
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if (valid_frame(d) and os.path.isfile(
                os.path.join(raw_dir, "screens", d["file"]))):
            out.append(d)
    return sorted(out, key=lambda d: d["t"])


_FRAME_FILE = re.compile(r"[0-9]+\.[0-9]s\.jpg")


def valid_frame(d):
    """A manifest entry with a finite offset and a frame file name of our
    own shape (a bare basename: never a path, never another file type)."""
    if not (isinstance(d, dict) and isinstance(d.get("file"), str)
            and _FRAME_FILE.fullmatch(d["file"]) is not None
            and isinstance(d.get("t"), (int, float))
            and not isinstance(d.get("t"), bool)):
        return False
    try:                 # a JSON integer like 10**400 overflows a float
        return math.isfinite(d["t"]) and abs(d["t"]) <= MAX_SEGMENT_SECONDS
    except OverflowError:
        return False


def append_private(path, text):
    """Append one record to a 0600 file in a single write; a partial write
    (disk full) is truncated away so the next record starts clean."""
    data = text.encode("utf-8")
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC,
                 0o600)
    try:
        size = os.fstat(fd).st_size
        try:
            if os.write(fd, data) != len(data):
                raise OSError(28, "short write")
        except OSError:
            try:
                os.ftruncate(fd, size)
            except OSError:
                pass
            raise
    finally:
        os.close(fd)


# What a session's raw (staging) dir may hold once the audio is mixed; the
# collector deletes it only if nothing else is in it.
RAW_SCREEN_ENTRIES = {"screens", "screens.jsonl", "screens.log"}


def collect_paths_error(raw_dir, folder):
    """Why collect-screens must not touch these paths (None if it may).
    raw_dir must be a session staging dir directly under CACHE_DIR with no
    meta.json; folder must be a recording folder (meta.json) outside it.
    So swapped or arbitrary arguments can never delete a recording."""
    cache = os.path.realpath(CACHE_DIR)
    raw, dest = os.path.realpath(raw_dir), os.path.realpath(folder)
    if os.path.dirname(raw) != cache or os.path.exists(
            os.path.join(raw, "meta.json")):
        return f"{raw_dir}: not a session staging dir in {CACHE_DIR}"
    if (not os.path.isfile(os.path.join(dest, "meta.json"))
            or dest == cache or dest.startswith(cache + os.sep)):
        return f"{folder}: not a recording folder (no meta.json)"
    return None


def collect_screens(raw_dir, folder):
    """Copy the kept frames from a raw session dir into <folder>/screens/
    (dir 0700, files 0600, each read back and compared), publish
    screens.json listing exactly the verified copies, merge the count into
    meta.json, then build moments.md if the transcript is already there.

    The raw dir is the only other copy, so it is deleted only when the
    paths check out (collect_paths_error), the manifest was READ (an
    unreadable one is an error, not "no frames"), every frame file in it
    was copied and verified, and it holds nothing else (a leftover WAV,
    an unlisted frame). Otherwise it stays for `meet-recorder
    collect-screens <raw> <folder>`. Copying stops before the output disk
    drops below [screens] min_free_mb (the transcript still has to be
    written there). Returns the number of frames published; never raises
    (screens must not cost audio)."""
    if not os.path.isdir(raw_dir):
        return 0
    why = collect_paths_error(raw_dir, folder)
    if why:
        print(f"collect-screens refused: {why}", file=sys.stderr)
        return 0
    done, ok = [], True
    try:
        frames = read_screens_jsonl(raw_dir)
        reserve = screen_params(load_config())["min_free_mb"] * 1e6
        if frames:
            dest = os.path.join(folder, "screens")
            make_private_dir(dest)
            for d in frames:
                try:
                    with open(os.path.join(raw_dir, "screens", d["file"]),
                              "rb") as f:
                        data = f.read()
                    st = os.statvfs(folder)
                    if st.f_bavail * st.f_frsize - len(data) < reserve:
                        ok = False
                        print("output disk nearly full: stopped copying "
                              "frames (min_free_mb)", file=sys.stderr)
                        break
                    target = os.path.join(dest, d["file"])
                    write_bytes_atomic(target, data, private=True)
                    with open(target, "rb") as f:
                        if f.read() != data:
                            raise OSError(f"{target}: differs after copy")
                    done.append(d)
                except OSError as e:
                    ok = False
                    print(f"copying {d['file']} failed: {e}", file=sys.stderr)
            if done:
                write_json(os.path.join(folder, "screens.json"), done,
                           private=True)
        log = os.path.join(raw_dir, "screens.log")
        if os.path.exists(log) and os.path.getsize(log):
            with open(log, "rb") as f:
                write_bytes_atomic(os.path.join(folder, "screens.log"),
                                   f.read()[-262144:], private=True)
        if frames:
            update_meta(folder, {"screens": len(done)})
        if ok:
            copied = {d["file"] for d in done}
            shots = os.path.join(raw_dir, "screens")
            names = os.listdir(shots) if os.path.isdir(shots) else []
            left = [n for n in names
                    if _FRAME_FILE.fullmatch(n) and n not in copied]
            extra = set(os.listdir(raw_dir)) - RAW_SCREEN_ENTRIES
            if left or extra:
                ok = False
                print(f"keeping {raw_dir}: holds uncollected "
                      f"{sorted(left) + sorted(extra)}", file=sys.stderr)
    except Exception as e:
        ok = False
        print(f"collecting screens failed: {e}", file=sys.stderr)
    if ok:
        shutil.rmtree(raw_dir, ignore_errors=True)
    if done:
        try:
            moments_if_ready(folder)
        except Exception as e:
            print(f"moments.md failed: {e}", file=sys.stderr)
    return len(done)


def moments_if_ready(folder, segments=None):
    """Write moments.md once both inputs exist (frames + a transcript).
    Called by both the transcriber and the screens collector, whichever
    finishes last; the folder lock makes the last writer see both."""
    with flock_path(folder):
        if not read_frames(folder):
            return None
        if segments is None:
            try:
                segments = folder_segments(folder)[0]
            except (OSError, ValueError):
                return None             # transcript not there (yet)
        return write_moments(folder, segments)


def spawn_screens(sess_dir, session_id, origin):
    """Start the detached screens-loop (it leads its own process group);
    returns (pid, start) or None."""
    try:
        fd = os.open(os.path.join(sess_dir, "screens.log"),
                     os.O_WRONLY | os.O_APPEND | os.O_CREAT | os.O_CLOEXEC,
                     0o600)
        try:
            p = subprocess.Popen([sys.executable, os.path.abspath(__file__),
                                  "screens-loop", sess_dir, session_id,
                                  repr(origin)],
                                 stdin=subprocess.DEVNULL, stdout=fd,
                                 stderr=fd, start_new_session=True)
        finally:
            os.close(fd)
        return p.pid, proc_start(p.pid)
    except OSError:
        return None


def spawn_collect(raw_dir, folder):
    """Collect screen frames in a detached job (see collect_screens)."""
    if not os.path.isdir(raw_dir):
        return
    try:
        fd = os.open(os.path.join(folder, "collect.log"),
                     os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_CLOEXEC,
                     0o600)
        try:
            subprocess.Popen([sys.executable, os.path.abspath(__file__),
                              "collect-screens", raw_dir, folder],
                             stdin=subprocess.DEVNULL, stdout=fd, stderr=fd,
                             start_new_session=True)
        finally:
            os.close(fd)
    except OSError as e:
        print(f"cannot start collect-screens: {e}", file=sys.stderr)


def load_folder_segments(folder):
    """Segment dicts for a session folder (folder_segments), else []."""
    try:
        return folder_segments(folder)[0]
    except (OSError, ValueError):
        return []


def read_frames(folder):
    """Frames listed in a session folder's screens.json that are valid
    (valid_frame) and whose JPEG exists in <folder>/screens/; [] if the
    manifest is missing or malformed."""
    frames = read_json(os.path.join(folder, "screens.json"))
    if not isinstance(frames, list):
        return []
    return [f for f in frames if valid_frame(f) and os.path.isfile(
        os.path.join(folder, "screens", f["file"]))]


def write_moments(folder, segments):
    """Write moments.md if the folder has screen frames; returns its path
    (None when there are no frames)."""
    frames = read_frames(folder)
    if not frames:
        return None
    path = os.path.join(folder, "moments.md")
    write_text_atomic(path, render_moments(frames, segments))
    return path


def spawn_summary(cmd, folder):
    """Run the optional post-transcription summarizer detached; never block
    or fail the recording pipeline if it errors."""
    log = open(os.path.join(folder, "summary.log"), "w")
    subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL,
                     stdout=log, stderr=log, start_new_session=True)


def spawn_transcribe(folder):
    """Transcribe in a detached process so nothing that launched us can kill it."""
    log = open(os.path.join(folder, "transcribe.log"), "w")
    subprocess.Popen([sys.executable, os.path.abspath(__file__),
                      "transcribe", folder],
                     stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                     start_new_session=True)


def recover_stale(state):
    """A previous session died (crash/reboot/recorders killed): stop
    whatever is left of it (a lingering screens worker) and clear it.
    Call under lifecycle_lock; returns the state, which the caller
    finalizes (finish_session) AFTER releasing the lock."""
    with lifecycle_lock():
        clear_state()
        stop_procs(state_procs(state), screens_proc(state), timeout=2)
    return state


def recover_if_stale():
    """Watcher: recover a session whose recorders all died, as soon as it
    is noticed (not only at the next start). Re-checks under the lock;
    the audio is mixed after the lock is released."""
    with lifecycle_lock():
        state = read_state()
        if state is None or session_live(state):
            return
        recover_stale(state)
    finish_session(state, ensure_config(), recovered=True)


def finish_session(state, cfg, recovered=False):
    """After the processes are stopped: mix the audio, then start the
    transcription and (separately) the screenshot collection. Returns an
    exit code."""
    try:
        folder = finalize_audio(state, cfg)
    except Exception as e:
        if not recovered:
            notify("Meeting recorder: saving failed", str(e))
        print(f"saving failed: {e}", file=sys.stderr)
        return 1
    try:
        write_json(LAST_FILE, {"folder": folder, "status": "transcribing"})
    except OSError as e:
        print(f"cannot write {LAST_FILE}: {e}", file=sys.stderr)
    spawn_transcribe(folder)
    try:                 # screens never cost the audio or the transcript
        spawn_collect(state.get("session_dir") or "", folder)
    except Exception as e:
        print(f"cannot start collect-screens: {e}", file=sys.stderr)
    if recovered:
        notify("Meeting recorder", "Recovered an interrupted recording:\n" + folder)
    else:
        notify("Recording saved — transcribing…", folder)
    print(folder)
    return 0


def stop_locked(expect_id=None, expect_source=None):
    """Stop the current session's processes and clear session.json; runs
    under lifecycle_lock and returns the stopped state for finish_session
    (called after the lock is released), or None if nothing was stopped.

    expect_id / expect_source (the watcher): stop only if session.json still
    names that session from that source -- the watcher decided outside the
    lock, and a manual recording may have replaced its Teams one since."""
    state = read_state()
    if state is None:
        print("Not recording.", file=sys.stderr)
        return None
    if expect_source is not None and (state.get("id") != expect_id
                                      or state.get("source") != expect_source):
        print("Session changed; not stopping it.", file=sys.stderr)
        return None
    # Never raises: a signalling problem (PID reuse, permissions) must not
    # cost the audio finalization.
    stop_procs(state_procs(state), screens_proc(state))
    clear_state()
    return state


def cmd_stop(args=(), expect_id=None, expect_source=None):
    cfg = ensure_config()
    try:
        with lifecycle_lock():
            state = stop_locked(expect_id, expect_source)
    except TimeoutError as e:
        print(f"busy: {e}", file=sys.stderr)
        return BUSY
    if state is None:
        return 1
    return finish_session(state, cfg)


def cmd_transcribe(args=()):
    """Transcribe (or re-transcribe) a session folder's meeting.m4a."""
    if not args:
        print("usage: meet-recorder transcribe <session-folder>", file=sys.stderr)
        return 2
    cfg = ensure_config()
    folder = os.path.abspath(os.path.expanduser(args[0]))
    audio = os.path.join(folder, "meeting.m4a")
    meta_path = os.path.join(folder, "meta.json")
    meta = read_json(meta_path) or {}
    marker = os.path.join(JOBS_DIR, f"{os.getpid()}.json")
    write_json(marker, {"pid": os.getpid(), "folder": folder})
    status = "failed"
    updates = {}         # merged into meta.json at the end (update_meta)
    try:
        me_audio = os.path.join(folder, "me.m4a")
        others_audio = os.path.join(folder, "others.m4a")
        if os.path.exists(me_audio) and os.path.exists(others_audio):
            (me, d1), (others, d2) = transcribe([me_audio, others_audio], cfg)
            segments, duration = merge_speakers(me, others), max(d1, d2)
            updates["speaker_labels"] = True
        else:
            [(segments, duration)] = transcribe([audio], cfg)
        start = os.path.getmtime(audio) - duration
        try:
            start = time.mktime(time.strptime(meta["started"][:19],
                                              "%Y-%m-%dT%H:%M:%S"))
        except (KeyError, ValueError):
            pass
        export_err = write_transcripts(folder, segments, start, duration,
                                       meta.get("title", ""), cfg)
        status = "done" if segments else "no-speech"
        try:     # frames may still be being collected; then that job does it
            moments_if_ready(folder, segment_dicts(segments))
        except Exception as e:   # never fails the transcription
            print(f"moments.md failed: {e}\nretry: meet-recorder moments "
                  f"{folder}", file=sys.stderr)
        if export_err:
            # transcript.md/.txt are fine; only the FocusTime files failed.
            print(f"export failed: {export_err}\n"
                  f"retry: meet-recorder export {folder}", file=sys.stderr)
            notify("Meeting recorder: FocusTime export failed",
                   f"{export_err}\nTranscript is fine. Retry: "
                   f"meet-recorder export {folder}")
        summary_cmd = cfg.get("summary", "summary_cmd", fallback="").strip()
        if status == "done" and summary_cmd:
            spawn_summary(summary_cmd.format(folder=folder), folder)
        updates.update({"duration_seconds": round(duration),
                        "whisper_model": cfg.get("whisper", "model")})
        notify("Transcript ready" if segments else "Recording saved (no speech found)",
               folder)
    except Exception as e:
        notify("Meeting recorder: transcription failed",
               f"{e}\nAudio is safe in {folder}")
        raise
    finally:
        updates["transcript_status"] = status
        update_meta(folder, updates)
        last = read_json(LAST_FILE) or {}
        if last.get("folder") == folder:
            write_json(LAST_FILE, {"folder": folder, "status": status})
        try:
            os.remove(marker)
        except OSError:
            pass
    print(folder)
    return 0


